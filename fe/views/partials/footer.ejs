    <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.6 15.6 18.9 12 24 12c3.1 0 5.9 1.2 8 3.1l6-6C34.6 5.5 29.6 3.5 24 3.5c-7.7 0-14.3 4.4-17.7 11.2z"/>
    <path fill="#4CAF50" d="M24 44.5c5.5 0 10.4-1.9 14.2-5.1l-6.6-5.4C29.6 35.8 27 36.7 24 36.7c-5.3 0-9.7-3.1-11.3-7.4l-6.5 5C9.6 40.1 16.2 44.5 24 44.5z"/>
    <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.3-2.3 4.2-4.3 5.6l6.6 5.4C41.6 36.1 44.5 30.6 44.5 24c0-1.2-.1-2.3-.3-3.5z"/>
  </svg>

  <span>Login dengan Google</span>
</a>

      <p class="text-xs text-stone-400 mt-3 text-center">Nama & email diambil otomatis dari akun Google-mu.</p>
    </div>

    <p id="bookingMsg" class="text-sm mt-3 hidden p-3 rounded-xl"></p>
  </div>
</div>

