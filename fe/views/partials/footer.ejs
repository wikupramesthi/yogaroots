<!-- Booking Modal -->
<div id="bookingModal" class="fixed inset-0 z-[60] hidden">
  <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="closeBooking()"></div>
  <div class="relative max-w-md mx-auto mt-[10vh] bg-white rounded-[24px] p-6 shadow-2xl m-4">
    <button onclick="closeBooking()" class="absolute right-4 top-4 w-8 h-8 rounded-full bg-sage-50 grid place-items-center">✕</button>
    <h3 class="font-display text-2xl font-bold">Begin Your Practice</h3>
    <p class="text-sm text-stone-warm mt-1">Sign in with Google and take the first step toward a healthier body and a more balanced mind.</p>

    <!-- STATE 1: belum login -->
    <div id="preAuthState" class="mt-5">
      <a
        id="googleLoginBtn"
        href="http://127.0.0.1:8000/auth/google"
        type="button"
        class="w-full flex items-center justify-center gap-3 py-3 rounded-xl border border-stone-200 bg-white font-medium text-stone-700 hover:bg-stone-50 transition"
      >
        <svg width="18" height="18" viewBox="0 0 48 48">
          <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.9 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l6-6C34.6 5.5 29.6 3.5 24 3.5 12.7 3.5 3.5 12.7 3.5 24S12.7 44.5 24 44.5 44.5 35.3 44.5 24c0-1.2-.1-2.3-.3-3.5z"/>
          <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.6 15.6 18.9 12 24 12c3.1 0 5.9 1.2 8 3.1l6-6C34.6 5.5 29.6 3.5 24 3.5c-7.7 0-14.3 4.4-17.7 11.2z"/>
          <path fill="#4CAF50" d="M24 44.5c5.5 0 10.4-1.9 14.2-5.1l-6.6-5.4C29.6 35.8 27 36.7 24 36.7c-5.3 0-9.7-3.1-11.3-7.4l-6.5 5C9.6 40.1 16.2 44.5 24 44.5z"/>
          <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.3-2.3 4.2-4.3 5.6l6.6 5.4C41.6 36.1 44.5 30.6 44.5 24c0-1.2-.1-2.3-.3-3.5z"/>
        </svg>
        <span>Sign in with Google</span>
      </a>
      <p class="text-xs text-stone-400 mt-3 text-center">Name and email are synced automatically.</p>
    </div>

    <p id="bookingMsg" class="text-sm mt-3 hidden p-3 rounded-xl"></p>
  </div>
</div>