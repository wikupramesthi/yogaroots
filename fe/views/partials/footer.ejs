        </svg>
    </a>

</div>

      </div>
      <div>
        <h4 class="font-semibold mb-3">Learn More</h4>
        <ul class="space-y-2 text-sm text-sage-200">
          <% nav.slice(1,6).forEach(n=>{ %><li><a href="<%= n.href %>" class="hover:text-white"><%= n.label %></a></li><% }) %>
        </ul>
      </div>
      <div>
        <h4 class="font-semibold mb-3">Kontak</h4>
        <ul class="space-y-2 text-sm text-sage-200">
          <li><%= site.address %></li>
          <li><%= site.phone %></li>
          <li><%= site.email %></li>
          <li class="text-xs"><%= site.hours || 'Open Daily · 6:00 AM — 9:00 PM' %></li>
        </ul>
      </div>
     <div>
  <h4 class="font-semibold mb-3">In Collaboration With</h4>

  <a href="https://www.artofliving.org/id-en/" target="_blank" rel="noopener noreferrer">
    <img
      src="https://www.artofliving.org/id-en/iimg/1551/180x/i.png"
      alt="Art of Living"
      class="h-10 w-auto object-contain"
    >
  </a>
</div>
    </div>
    <div class="border-t border-white/10 mt-10 pt-6 flex flex-col sm:flex-row justify-between gap-2 text-xs text-sage-300">
      <span>© <%= site.year %> Yoga Roots. all rights reserved.</span>
      <a
    href="/pages/kebijakan-privasi"
    class="hover:text-white transition"
  >
   Privacy Policy
  </a>
    </div>
  </div>
</footer>

