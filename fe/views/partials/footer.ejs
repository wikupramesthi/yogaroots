        <div class="flex gap-2 mt-4">
    <!-- Instagram -->
    <a href="https://www.instagram.com/yogaroot.id/" target="_blank" rel="noopener noreferrer"
       class="w-8 h-8 rounded-full bg-white/10 grid place-items-center hover:bg-white/20 transition"
       aria-label="Instagram">
        <svg xmlns="http://www.w3.org/2000/svg"
             viewBox="0 0 24 24"
             class="w-4 h-4"
             fill="currentColor">
