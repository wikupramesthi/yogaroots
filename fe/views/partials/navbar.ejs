<header id="navbar" class="sticky top-0 z-50 glass border-b border-sage-100 transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-[68px]">
      <!-- Logo -->
     <a href="/" class="flex items-center gap-3">
  <img
    src="https://www.yogaroots.id/images/logo.png"
    alt="YogaRoots"
    class="w-20 h-auto object-contain">
</a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-1">
        <% nav.forEach(item => { %>
          <a href="<%= item.href %>" class="px-3 py-2 rounded-full text-sm font-medium transition <%= currentPath===item.href ? 'bg-sage-700 text-white' : 'text-stone-warm hover:text-ink hover:bg-sage-50' %>"><%= item.label %></a>
        <% }) %>
      </nav>

      <div class="flex items-center gap-2">
        <button id="darkToggle" class="w-9 h-9 rounded-full border border-sage-200 grid place-items-center text-sm hover:bg-sage-50" title="Toggle theme">◐</button>
        <a href="/contact" class="hidden sm:inline-flex items-center gap-2 bg-terracotta-600 hover:bg-terracotta-500 text-white px-5 py-2.5 rounded-full text-sm font-semibold transition">Book Kelas</a>
        <button id="mobileBtn" class="lg:hidden w-9 h-9 rounded-full bg-sage-700 text-white grid place-items-center">☰</button>
      </div>
    </div>
  </div>
  <!-- Mobile drawer -->
  <div id="mobileNav" class="hidden lg:hidden border-t border-sage-100 bg-cream px-4 py-4 space-y-1">
    <% nav.forEach(item => { %>
      <a href="<%= item.href %>" class="block px-4 py-3 rounded-xl text-sm font-medium <%= currentPath===item.href ? 'bg-sage-700 text-white' : 'bg-white border border-sage-100' %>"><%= item.label %></a>
    <% }) %>
    <a href="/contact" class="block text-center bg-terracotta-600 text-white px-4 py-3 rounded-xl font-semibold mt-2">Book Kelas Sekarang →</a>
  </div>
</header>
