<%# CTA "Need help" — dipakai di blog-detail, classes, instructors (satu sumber) %>
<div
  class="bg-white border border-sage-100 rounded-[24px] p-6 mt-8 flex flex-col lg:flex-row justify-between gap-4 items-start lg:items-center"
>
  <div>
    <h3 class="font-semibold text-sage-900">
      <%= t.ctaHelpTitle %>
    </h3>

    <p class="text-sm text-stone-500 mt-1">
      <%= t.ctaHelpDesc %>
    </p>
  </div>

  <a
    href="<%= contactLinks.whatsappLink %>"
    target="_blank"
    rel="noopener noreferrer"
    class="bg-sage-700 text-white px-6 py-3 rounded-full text-sm font-semibold shrink-0 hover:bg-sage-800 transition"
  >
    <%= t.ctaHelpBtn %>
  </a>
</div>
