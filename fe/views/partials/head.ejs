<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %> — Serene Yoga</title>
<meta name="description" content="Serene — Studio yoga & mindfulness di Jakarta. Kelas Hatha, Vinyasa, Yin, Meditasi untuk semua level.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/output.css">
<link rel="stylesheet" href="/css/custom.css">
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🪷</text></svg>">
<script>
  (function(){
    try {
      const saved = localStorage.getItem('serene-dark');
      const prefers = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (saved === 'true' || (!saved && prefers)) document.documentElement.classList.add('dark');
    } catch(e) {}
  })();
</script>
