<%# Modal booking — diekstrak dari footer agar footer hanya berisi footer %>
<%# `user` diisi appLocals dari backend GET /auth/me (null = anonim) %>
<div id="bookingModal" class="fixed inset-0 z-[60] hidden">
  <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" data-action="close-booking"></div>
  <div class="relative max-w-md mx-auto mt-[10vh] bg-white rounded-[24px] p-6 shadow-2xl m-4">
    <button type="button" data-action="close-booking" class="absolute right-4 top-4 w-8 h-8 rounded-full bg-sage-50 grid place-items-center" aria-label="<%= t.closeModal || 'Close' %>">✕</button>

    <% if (user) { %>
      <!-- STATE: sudah login -->
      <h3 class="font-display text-2xl font-bold"><%= t.bookingSignedInTitle %></h3>
      <p class="text-sm text-stone-warm mt-1"><%= t.bookingSignedInDesc %></p>

      <div class="mt-5 flex items-center gap-3 rounded-2xl bg-sage-50/70 ring-1 ring-sage-100 px-4 py-3">
        <% if (user.avatar) { %>
          <img src="<%= user.avatar %>" alt="" width="40" height="40" loading="lazy" decoding="async" class="w-10 h-10 rounded-full object-cover shrink-0 ring-1 ring-sage-200">
        <% } else { %>
          <span aria-hidden="true" class="w-10 h-10 rounded-full bg-sage-700 text-white grid place-items-center text-sm font-semibold shrink-0"><%= (user.name || user.email || '?').trim().charAt(0).toUpperCase() %></span>
        <% } %>
        <div class="min-w-0">
          <p class="text-[11px] uppercase tracking-[0.15em] text-stone-warm"><%= t.signedInAs %></p>
          <p class="text-sm font-semibold text-sage-900 truncate"><%= user.name || user.email %></p>
        </div>
      </div>

      <div class="mt-4 flex flex-col gap-2">
        <a href="/schedules" class="w-full flex items-center justify-center gap-2 py-3 rounded-xl bg-sage-700 text-white font-medium transition-colors hover:bg-sage-800">
          <%= t.viewSchedule %>
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>
        <a href="<%= contactLinks.whatsappShortLink %>" target="_blank" rel="noopener noreferrer" class="w-full flex items-center justify-center gap-2 py-3 rounded-xl border border-stone-200 text-stone-700 font-medium transition-colors hover:bg-stone-50">
          <%= t.whatsappAdmin %>
        </a>
        <button type="button" data-action="logout" class="w-full py-2.5 text-sm text-stone-warm hover:text-terracotta-600 transition-colors"><%= t.signOut %></button>
      </div>

    <% } else { %>
      <!-- STATE: belum login -->
      <h3 class="font-display text-2xl font-bold"><%= t.bookingSignedOutTitle %></h3>
      <p class="text-sm text-stone-warm mt-1"><%= t.bookingSignedOutDesc %></p>

      <div id="preAuthState" class="mt-5">
        <a
          id="googleLoginBtn"
          href="<%= contactLinks.googleAuthUrl %>"
          class="w-full flex items-center justify-center gap-3 py-3 rounded-xl border border-stone-200 bg-white font-medium text-stone-700 hover:bg-stone-50 transition"
        >
          <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
            <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.9 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l6-6C34.6 5.5 29.6 3.5 24 3.5 12.7 3.5 3.5 12.7 3.5 24S12.7 44.5 24 44.5 44.5 35.3 44.5 24c0-1.2-.1-2.3-.3-3.5z"/>
            <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.6 15.6 18.9 12 24 12c3.1 0 5.9 1.2 8 3.1l6-6C34.6 5.5 29.6 3.5 24 3.5c-7.7 0-14.3 4.8-19.7 11.2z"/>
            <path fill="#4CAF50" d="M24 44.5c5.5 0 10.4-1.9 14.2-5.1l-6.6-5.4C29.6 35.8 27 36.7 24 36.7c-5.3 0-9.7-3.1-11.3-7.4l-6.5 5C9.6 40.1 16.2 44.5 24 44.5z"/>
            <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.3-2.3 4.2-4.3 5.6l6.6 5.4C41.6 36.1 44.5 30.6 44.5 24c0-1.2-.1-2.3-.3-3.5z"/>
          </svg>
          <span><%= t.loginWithGoogle || 'Sign in with Google' %></span>
        </a>
        <p class="text-xs text-stone-400 mt-3 text-center"><%= t.syncedNote %></p>
      </div>
    <% } %>

    <p id="bookingMsg" class="text-sm mt-3 hidden p-3 rounded-xl" data-signout-error="<%= t.signOutFailed %>"></p>
  </div>
</div>