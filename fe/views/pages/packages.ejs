<!DOCTYPE html>
<html lang="<%= lang || 'en' %>">

<head>
    <%- include('../partials/head') %>
</head>

<body class="antialiased bg-[#fafaf8]">

    <%- include('../partials/navbar') %>


    <main>

        <!-- HEADER -->
        <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-8">

  <div class="max-w-2xl">

         <h1 class="font-display text-4xl lg:text-5xl font-bold text-sage-900 mt-3 leading-tight">
                <%= t.packagesTitleA %>
                <span class="text-terracotta-600"><%= t.packagesTitleB %></span>
            </h1>

                <p class="mt-3 text-sm sm:text-base text-stone-500 leading-relaxed">
                   <%= t.packagesDesc %>
                </p>

                    </div>

        </section>


        <!-- FILTER -->
        <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

            <form
                action="/packages"
                method="GET"
                class="bg-white border border-stone-200 rounded-2xl p-3 shadow-sm"
            >

                <div class="grid grid-cols-1 md:grid-cols-12 gap-3">

                    <!-- SEARCH -->
                    <div class="md:col-span-5 relative">

                        <span
                            class="absolute inset-y-0 left-0 flex items-center pl-4
                            text-stone-400 pointer-events-none"
                        >
                            <i class="bi bi-search"></i>
                        </span>

                        <input
                            type="text"
                            name="search"
                            value="<%= search || '' %>"
                            placeholder="Search membership packages..."
                            class="w-full h-11 rounded-xl
                            border border-stone-200
                            bg-[#fafaf8]
                            pl-11 pr-4
                            text-sm text-stone-700
                            focus:outline-none
                            focus:ring-2 focus:ring-sage-200
                            focus:border-sage-500"
                        >

                    </div>


                    <!-- FILTER -->
                    <div class="md:col-span-3">

                        <select
                            name="filter"
                            class="w-full h-11 rounded-xl
                            border border-stone-200
                            bg-[#fafaf8]
                            px-4 text-sm text-stone-700
                            focus:outline-none
                            focus:ring-2 focus:ring-sage-200
                            focus:border-sage-500"
                        >

                            <option value="">
                                All Packages
                            </option>

                            <option
                                value="popular"
                                <%= filter === 'popular' ? 'selected' : '' %>
                            >
                                Popular
                            </option>

                            <option
                                value="unlimited"
                                <%= filter === 'unlimited' ? 'selected' : '' %>
                            >
                                Unlimited
                            </option>

                        </select>

                    </div>


                    <!-- SORT -->
                    <div class="md:col-span-2">

                        <select
                            name="sort"
                            class="w-full h-11 rounded-xl
                            border border-stone-200
                            bg-[#fafaf8]
                            px-4 text-sm text-stone-700
                            focus:outline-none
                            focus:ring-2 focus:ring-sage-200
                            focus:border-sage-500"
                        >

                            <option value="">
                                Default
                            </option>

                            <option
                                value="popular"
                                <%= sort === 'popular' ? 'selected' : '' %>
                            >
                                Popular
                            </option>

                            <option
                                value="lowest_price"
                                <%= sort === 'lowest_price' ? 'selected' : '' %>
                            >
                                Lowest Price
                            </option>

                        </select>

                    </div>


                    <!-- BUTTON -->
                    <div class="md:col-span-2 flex gap-2">

                        <button
                            type="submit"
                            class="flex-1 h-11 rounded-xl
                            bg-sage-700 text-white
                            text-sm font-semibold
                            hover:bg-sage-800 transition"
                        >
                            Search
                        </button>


                        <% if (search || filter || sort) { %>

                            <a
                                href="/packages"
                                class="w-11 h-11 flex items-center justify-center
                                rounded-xl border border-stone-200
                                text-stone-500 hover:bg-stone-50"
                            >
                               <svg xmlns="http://www.w3.org/2000/svg"
     width="18"
     height="18"
     viewBox="0 0 24 24"
     fill="none"
     stroke="currentColor"
     stroke-width="2"
     stroke-linecap="round"
     stroke-linejoin="round">
    <line x1="18" y1="6" x2="6" y2="18"></line>
    <line x1="6" y1="6" x2="18" y2="18"></line>
</svg>
                            </a>

                        <% } %>

                    </div>

                </div>

            </form>


            <!-- QUICK FILTER -->
            <div class="flex flex-wrap items-center gap-2 mt-4">

                <span class="text-xs text-stone-400 mr-1">
                    Browse by
                </span>


                <a
                    href="/packages"
                    class="px-4 py-2 rounded-full text-xs font-semibold
                    <%= !filter
                        ? 'bg-sage-700 text-white'
                        : 'bg-white border border-stone-200 text-stone-600'
                    %>"
                >
                    All
                </a>


                <a
                    href="/packages?filter=popular"
                    class="px-4 py-2 rounded-full text-xs font-semibold
                    <%= filter === 'popular'
                        ? 'bg-sage-700 text-white'
                        : 'bg-white border border-stone-200 text-stone-600'
                    %>"
                >
                    Popular
                </a>


                <a
                    href="/packages?filter=unlimited"
                    class="px-4 py-2 rounded-full text-xs font-semibold
                    <%= filter === 'unlimited'
                        ? 'bg-sage-700 text-white'
                        : 'bg-white border border-stone-200 text-stone-600'
                    %>"
                >
                    Unlimited
                </a>

            </div>

        </section>


        <!-- PACKAGE LIST -->
        <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

            <!-- COUNT -->
            <div class="mb-6">

                <p class="text-sm text-stone-500">

                    Showing
                    <span class="font-semibold text-stone-700">
                        <%= totalPackages %>
                    </span>
                    packages

                </p>

            </div>


            <!-- ERROR -->
            <% if (error) { %>

                <div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-600">

                    <i class="bi bi-exclamation-circle mr-1"></i>

                    <%= error %>

                </div>

            <% } %>


            <!-- PACKAGES -->
            <% if (packages && packages.length > 0) { %>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 items-stretch">

                    <% packages.forEach(function(pkg) { %>

                        <%
                            const options = Array.isArray(pkg.options)
                                ? pkg.options
                                : [];

                            const features = Array.isArray(pkg.features)
                                ? pkg.features
                                : [];

                            const isPopular =
                                pkg.is_popular === true ||
                                pkg.is_popular === 1 ||
                                pkg.is_popular === '1';


                            let lowestOption = null;
                            let lowestPrice = null;


                            options.forEach(function(option) {

                                const finalPrice = Number(
                                    option.final_price ??
                                    option.price ??
                                    0
                                );


                                if (
                                    lowestPrice === null ||
                                    finalPrice < lowestPrice
                                ) {

                                    lowestPrice = finalPrice;
                                    lowestOption = option;

                                }

                            });


                            function formatPrice(price) {

                                return new Intl.NumberFormat('id-ID').format(
                                    Number(price || 0)
                                );

                            }
                        %>


                        <!-- CARD -->
                       <article
    class="relative rounded-[24px] p-7 border flex flex-col h-full
           transition-all duration-300 hover:-translate-y-1
           <%= isPopular
               ? 'bg-sage-700 text-white border-sage-700 shadow-xl'
               : 'bg-white border-stone-200 hover:shadow-lg'
           %>"
>

                            <!-- POPULAR -->
                            <% if (isPopular) { %>

                                <span
                                    class="self-start inline-flex items-center gap-1.5
                                    bg-terracotta-500 text-white
                                    text-[10px] font-bold tracking-widest
                                    px-3 py-1.5 rounded-full"
                                >

                                    <i class="bi bi-star-fill"></i>

                                    MOST POPULAR

                                </span>

                            <% } %>


                            <!-- NAME -->
                            <h2
                                class="font-display text-2xl font-bold leading-tight
                                <%= isPopular
                                    ? 'mt-4 text-white'
                                    : 'text-sage-900'
                                %>"
                            >
                                <%= pkg.name %>
                            </h2>


                            <!-- DESCRIPTION -->
                            <% if (pkg.description) { %>

                                <p
                                    class="text-sm leading-relaxed mt-2
                                    <%= isPopular
                                        ? 'text-sage-200'
                                        : 'text-stone-warm'
                                    %>"
                                >
                                    <%= pkg.description %>
                                </p>

                            <% } %>


                            <!-- OPTIONS -->
                            <% if (options.length > 0) { %>

                                <div class="mt-6 space-y-2">

                                    <% options.forEach(function(option) { %>

                                        <div
                                            class="rounded-xl px-3 py-3
                                            <%= isPopular
                                                ? 'bg-white/10'
                                                : 'bg-stone-50'
                                            %>"
                                        >

                                            <div class="flex items-center justify-between gap-3">

                                                <div>

                                                    <p class="text-xs font-semibold">
                                                        <%= option.name %>
                                                    </p>

                                                    <p
                                                        class="text-[11px] mt-1
                                                        <%= isPopular
                                                            ? 'text-sage-200'
                                                            : 'text-stone-400'
                                                        %>"
                                                    >
                                                        <%= option.duration %>
                                                        <%= option.duration_unit || '' %>

                                                    </p>

                                                </div>


                                                <div class="text-right shrink-0">

                                                    <p class="text-xs font-bold">

                                                        Rp
                                                        <%= formatPrice(option.final_price) %>

                                                    </p>

                                                </div>

                                            </div>

                                        </div>

                                    <% }) %>

                                </div>

                            <% } %>


                            <!-- FEATURES -->
                            <% if (features.length > 0) { %>

                                <div
                                    class="mt-5 pt-5 mb-5 border-t
                                    <%= isPopular
                                        ? 'border-white/10'
                                        : 'border-stone-100'
                                    %>"
                                >

                                    <p
                                        class="text-xs font-semibold uppercase
                                        tracking-wider mb-3
                                        <%= isPopular
                                            ? 'text-sage-200'
                                            : 'text-stone-500'
                                        %>"
                                    >
                                        What's included
                                    </p>


                                    <ul class="space-y-2">

                                        <% features.forEach(function(feature) { %>

                                            <li
                                                class="flex items-start gap-2 text-sm
                                                <%= isPopular
                                                    ? 'text-sage-100'
                                                    : 'text-stone-warm'
                                                %>"
                                            >

                                            <span class="<%= isPopular ? 'text-white' : 'text-sage-700' %>">
    <svg xmlns="http://www.w3.org/2000/svg"
         width="18"
         height="18"
         viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="2.5"
         stroke-linecap="round"
         stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12"></polyline>
    </svg>
</span>

                                                <span>
                                                    <%= feature.feature %>
                                                </span>

                                            </li>

                                        <% }) %>

                                    </ul>

                                </div>

                            <% } %>


                            <!-- CTA -->
                           <a
    href="/packages/<%= pkg.slug %>"
    class="w-full mt-auto py-3.5 rounded-full
           flex items-center justify-center
           font-semibold text-sm transition
           <%= isPopular
               ? 'bg-white text-sage-700 hover:bg-sage-50'
               : 'bg-sage-700 text-white hover:bg-sage-800'
           %>"
>
    View Package
    <i class="bi bi-arrow-right ms-1"></i>
</a>

                        </article>

                    <% }) %>

                </div>


            <% } else { %>

                <!-- EMPTY -->
                <div class="bg-white border border-stone-200 rounded-2xl py-20 text-center">

                    <div class="text-4xl">
                        🧘
                    </div>

                    <h3 class="mt-5 text-lg font-bold text-sage-900">
                        No packages available
                    </h3>

                    <p class="mt-2 text-sm text-stone-500">
                        Try changing your search or filter.
                    </p>

                </div>

            <% } %>

        </section>

    </main>


    <%- include('../partials/footer') %>

    <script src="/js/main.js"></script>

</body>

</html>