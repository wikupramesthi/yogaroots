<!DOCTYPE html>
<html lang="<%= lang || 'en' %>">
  <head>
    <%- include('../partials/head') %>
  </head>

  <body class="antialiased bg-cream">
    <%- include('../partials/navbar') %>

    <section class="bg-cream pt-6 sm:pt-10 pb-6 sm:pb-8">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div
          class="flex flex-col md:flex-row md:items-end md:justify-between gap-4"
        >
          <div>
            <span
              class="text-xs font-bold tracking-[0.2em] text-terracotta-600"
            >
              <%= t.classesEyebrow %>
            </span>

            <h1 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold mt-2 leading-tight">
              <%= t.classesTitle %>
            </h1>

            <p class="text-stone-warm mt-3 max-w-2xl leading-relaxed text-[15px] sm:text-base">
              <%= t.classesDesc %>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================= -->
    <!-- MAIN CONTENT -->
    <!-- ========================================= -->

    <section class="bg-cream pb-16 sm:pb-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-[240px_1fr] gap-5 lg:gap-8">
          <!-- ===================================== -->
          <!-- FILTER -->
          <!-- ===================================== -->

          <!-- Mobile filter toggle -->
          <div class="lg:hidden">
            <button
              id="filterToggle"
              type="button"
              aria-expanded="false"
              aria-controls="filterAside"
              class="w-full flex items-center justify-between bg-white rounded-2xl border border-sage-100 px-4 py-3.5 text-sm font-semibold shadow-sm active:scale-[0.99] transition"
            >
              <span class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="21" y2="21"/><line x1="4" x2="20" y1="14" y2="14"/><line x1="4" x2="20" y1="7" y2="7"/><line x1="12" x2="12" y1="3" y2="7"/><line x1="12" x2="12" y1="10" y2="14"/><line x1="12" x2="12" y1="17" y2="21"/></svg>
                Filter Classes
                <span id="filterActiveDot" class="hidden w-2 h-2 rounded-full bg-terracotta-600"></span>
              </span>
              <svg id="filterChevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200"><path d="m6 9 6 6 6-6"/></svg>
            </button>
          </div>

          <aside id="filterAside" class="hidden lg:block">
            <div
              class="bg-white rounded-[20px] sm:rounded-[24px] border border-sage-100 p-4 sm:p-5 lg:sticky lg:top-28"
            >
              <div class="flex items-center justify-between mb-5">
                <h3 class="font-semibold">Filter</h3>

                <button
                  id="resetFilters"
                  type="button"
                  class="text-xs text-sage-700 font-semibold"
                >
                  Reset
                </button>
              </div>

              <!-- LEVEL -->

              <div class="mb-6">
                <h4
                  class="text-xs font-bold uppercase tracking-wider text-stone-warm mb-3"
                >
                  Level
                </h4>

                <div class="space-y-2" data-filter-group="level">
                  <label class="flex items-center gap-3 cursor-pointer py-1.5 sm:py-1 min-h-[40px] sm:min-h-0">
                    <input
                      type="checkbox"
                      value=""
                      checked
                      class="w-5 h-5 sm:w-4 sm:h-4 accent-sage-700 shrink-0"
                    />
                    <span class="text-sm">All Levels</span>
                  </label>

                  <label class="flex items-center gap-3 cursor-pointer py-1.5 sm:py-1 min-h-[40px] sm:min-h-0">
                    <input
                      type="checkbox"
                      value="foundation"
                      class="w-5 h-5 sm:w-4 sm:h-4 accent-sage-700 shrink-0"
                    />
                    <span class="text-sm">Foundation</span>
                  </label>

                  <label class="flex items-center gap-3 cursor-pointer py-1.5 sm:py-1 min-h-[40px] sm:min-h-0">
                    <input
                      type="checkbox"
                      value="intermediate"
                      class="w-5 h-5 sm:w-4 sm:h-4 accent-sage-700 shrink-0"
                    />
                    <span class="text-sm">Intermediate</span>
                  </label>

                  <label class="flex items-center gap-3 cursor-pointer py-1.5 sm:py-1 min-h-[40px] sm:min-h-0">
                    <input
                      type="checkbox"
                      value="advance"
                      class="w-5 h-5 sm:w-4 sm:h-4 accent-sage-700 shrink-0"
                    />
                    <span class="text-sm">Advance</span>
                  </label>
                </div>
              </div>

              <!-- TIME -->

              <div class="mb-6">
                <h4
                  class="text-xs font-bold uppercase tracking-wider text-stone-warm mb-3"
                >
                  Time
                </h4>

                <div class="space-y-2" data-filter-group="time">
                  <label class="flex items-center gap-3 cursor-pointer py-1.5 sm:py-1 min-h-[40px] sm:min-h-0">
                    <input
                      type="checkbox"
                      value=""
                      checked
                      class="w-5 h-5 sm:w-4 sm:h-4 accent-sage-700 shrink-0"
                    />
                    <span class="text-sm">All Times</span>
                  </label>

                  <label class="flex items-center gap-3 cursor-pointer py-1.5 sm:py-1 min-h-[40px] sm:min-h-0">
                    <input
                      type="checkbox"
                      value="morning"
                      class="w-5 h-5 sm:w-4 sm:h-4 accent-sage-700 shrink-0"
                    />
                    <span class="text-sm">Morning</span>
                  </label>

                  <label class="flex items-center gap-3 cursor-pointer py-1.5 sm:py-1 min-h-[40px] sm:min-h-0">
                    <input
                      type="checkbox"
                      value="afternoon"
                      class="w-5 h-5 sm:w-4 sm:h-4 accent-sage-700 shrink-0"
                    />
                    <span class="text-sm">Afternoon</span>
                  </label>

                  <label class="flex items-center gap-3 cursor-pointer py-1.5 sm:py-1 min-h-[40px] sm:min-h-0">
                    <input
                      type="checkbox"
                      value="evening"
                      class="w-5 h-5 sm:w-4 sm:h-4 accent-sage-700 shrink-0"
                    />
                    <span class="text-sm">Evening</span>
                  </label>
                </div>
              </div>

              <!-- STUDIO -->

              <div>
                <h4
                  class="text-xs font-bold uppercase tracking-wider text-stone-warm mb-3"
                >
                  Studio
                </h4>

                <div
                  id="studioFilters"
                  class="space-y-2"
                  data-filter-group="studio"
                >
                  <label class="flex items-center gap-3 cursor-pointer py-1.5 sm:py-1 min-h-[40px] sm:min-h-0">
                    <input
                      type="checkbox"
                      value=""
                      checked
                      class="w-5 h-5 sm:w-4 sm:h-4 accent-sage-700 shrink-0"
                    />
                    <span class="text-sm">All Studios</span>
                  </label>
                </div>
              </div>
            </div>
          </aside>

          <!-- ===================================== -->
          <!-- SCHEDULE -->
          <!-- ===================================== -->

          <main class="min-w-0">
            <!-- DATE SELECTOR -->
            <div
              class="bg-white rounded-[20px] sm:rounded-[24px] border border-sage-100 p-2 sm:p-3 shadow-sm mb-4 sm:mb-5"
            >
              <div class="flex flex-col sm:flex-row sm:items-center gap-2">
                <div class="flex items-center gap-1.5 sm:gap-2 flex-1 min-w-0">
                  <button
                    id="weekPrev"
                    type="button"
                    aria-label="Previous week"
                    class="shrink-0 w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-sage-100 flex items-center justify-center hover:bg-sage-50 active:bg-sage-100 transition"
                  >
                    <span class="text-lg leading-none">‹</span>
                  </button>

                  <div id="dateRow" class="flex gap-1.5 sm:gap-2 flex-1 min-w-0 overflow-x-auto no-scrollbar scroll-smooth snap-x snap-mandatory"></div>

                  <button
                    id="weekNext"
                    type="button"
                    aria-label="Next week"
                    class="shrink-0 w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-sage-100 flex items-center justify-center hover:bg-sage-50 active:bg-sage-100 transition"
                  >
                    <span class="text-lg leading-none">›</span>
                  </button>
                </div>
                <button
                  id="todayBtn"
                  type="button"
                  class="w-full sm:w-auto shrink-0 px-3 h-9 sm:h-10 rounded-full border border-sage-100 text-[11px] sm:text-xs font-semibold text-sage-700 hover:bg-sage-50 active:bg-sage-100 transition"
                >
                  Today
                </button>
              </div>
            </div>

            <div
              class="flex flex-col gap-1.5 sm:gap-3 mb-4 sm:mb-5 sm:flex-row sm:items-center sm:justify-between"
            >
              <div class="min-w-0">
                <h2 id="scheduleTitle" class="text-lg sm:text-xl font-bold truncate"></h2>

                <p id="scheduleCount" class="text-[13px] sm:text-sm text-stone-warm mt-0.5 sm:mt-1"></p>
              </div>

              <div
                id="scheduleFilterNote"
                class="text-xs sm:text-sm text-stone-warm shrink-0"
              >
                Showing all classes
              </div>
            </div>

            <div id="scheduleList" class="min-w-0"></div>
          </main>
        </div>

        <%- include('../partials/cta-help') %>
      </div>
    </section>

    <%- include('../partials/footer') %>

    <!-- main.js dimuat sekali via partials/footer -->
    <script>
      (function () {
        "use strict";

        var LEVELS = ["foundation", "intermediate", "advance"];

        var state = {
          selected: startOfDay(new Date()),
          weekStart: startOfWeek(new Date()),
          level: "",
          time: "",
          studio: "",
        };

        var dateRow = document.getElementById("dateRow");
        var scheduleList = document.getElementById("scheduleList");
        var scheduleTitle = document.getElementById("scheduleTitle");
        var scheduleCount = document.getElementById("scheduleCount");
        var scheduleFilterNote = document.getElementById("scheduleFilterNote");
        var studioFilters = document.getElementById("studioFilters");

        function startOfDay(d) {
          return new Date(d.getFullYear(), d.getMonth(), d.getDate());
        }

        function startOfWeek(d) {
          var day = d.getDay();
          return new Date(d.getFullYear(), d.getMonth(), d.getDate() - day);
        }

        function fmtISO(d) {
          var y = d.getFullYear();
          var m = String(d.getMonth() + 1).padStart(2, "0");
          var da = String(d.getDate()).padStart(2, "0");
          return y + "-" + m + "-" + da;
        }

        function escapeHtml(s) {
          return String(s == null ? "" : s)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#x27;");
        }

        function sameDay(a, b) {
          return a.getTime() === b.getTime();
        }

        /* ---------- date selector ---------- */

        function renderDates() {
          var html = "";
          for (var i = 0; i < 7; i++) {
            var d = new Date(state.weekStart);
            d.setDate(d.getDate() + i);
            var isSelected = sameDay(d, state.selected);
            var isToday = sameDay(d, startOfDay(new Date()));
            html +=
              '<button type="button" data-date="' +
              fmtISO(d) +
              '" class="date-item flex-1 min-w-[60px] sm:min-w-[76px] snap-start px-2 sm:px-3 py-2 sm:py-3 rounded-xl sm:rounded-2xl text-center transition active:scale-[0.98] ' +
              (isSelected
                ? "bg-sage-700 text-white shadow-sm"
                : "hover:bg-sage-50 active:bg-sage-100 " + (isToday ? "border border-sage-300" : "border border-transparent")) +
              '">' +
              '<div class="text-[11px] sm:text-xs ' +
              (isSelected ? "opacity-80" : "text-stone-warm") +
              '">' +
              d.toLocaleDateString("en-US", { weekday: "short" }) +
              "</div>" +
              '<div class="text-lg sm:text-xl font-bold mt-0.5 sm:mt-1 leading-tight">' +
              d.getDate() +
              "</div>" +
              '<div class="text-[10px] sm:text-[11px] ' +
              (isSelected ? "opacity-80" : "text-stone-warm") +
              ' mt-0.5">' +
              d.toLocaleDateString("en-US", { month: "short" }) +
              "</div></button>";
          }
          dateRow.innerHTML = html;

          dateRow.querySelectorAll("[data-date]").forEach(function (btn) {
            btn.addEventListener("click", function () {
              state.selected = new Date(btn.getAttribute("data-date") + "T00:00:00");
              renderDates();
              loadAll();
            });
          });
        }

        document.getElementById("todayBtn").addEventListener("click", function () {
          state.selected = startOfDay(new Date());
          state.weekStart = startOfWeek(new Date());
          renderDates();
          loadAll();
        });

        document.getElementById("weekPrev").addEventListener("click", function () {
          state.weekStart.setDate(state.weekStart.getDate() - 7);
          state.selected.setDate(state.selected.getDate() - 7);
          renderDates();
          loadAll();
        });

        document.getElementById("weekNext").addEventListener("click", function () {
          state.weekStart.setDate(state.weekStart.getDate() + 7);
          state.selected.setDate(state.selected.getDate() + 7);
          renderDates();
          loadAll();
        });

        /* ---------- filters ---------- */

        function groupValue(name) {
          var group = document.querySelector(
            '[data-filter-group="' + name + '"]',
          );
          var boxes = group.querySelectorAll('input[type="checkbox"]');
          var checked = Array.prototype.filter.call(boxes, function (b) {
            return b.checked && b.value !== "";
          });
          return checked.length ? checked[0].value : "";
        }

        function bindGroup(name) {
          var group = document.querySelector(
            '[data-filter-group="' + name + '"]',
          );
          group.addEventListener("change", function (e) {
            var boxes = group.querySelectorAll('input[type="checkbox"]');
            if (e.target.value === "") {
              boxes.forEach(function (b) {
                b.checked = b === e.target;
              });
            } else {
              boxes.forEach(function (b) {
                if (b.value === "") b.checked = false;
                if (b !== e.target) b.checked = false;
              });
              e.target.checked = true;
            }
            state.level = groupValue("level");
            state.time = groupValue("time");
            state.studio = groupValue("studio");
            loadSchedules();
          });
        }

        document.getElementById("resetFilters").addEventListener("click", function () {
          document.querySelectorAll("[data-filter-group]").forEach(function (g) {
            g.querySelectorAll('input[type="checkbox"]').forEach(function (b) {
              b.checked = b.value === "";
            });
          });
          state.level = "";
          state.time = "";
          state.studio = "";
          loadSchedules();
        });

        function renderStudioOptions(studios) {
          var exists = studios.some(function (s) {
            return s.uuid === state.studio;
          });
          if (state.studio && !exists) state.studio = "";
          var current = state.studio;
          var html =
            '<label class="flex items-center gap-3 cursor-pointer py-1.5 sm:py-1 min-h-[40px] sm:min-h-0">' +
            '<input type="checkbox" value="" ' +
            (current === "" ? "checked" : "") +
            ' class="w-5 h-5 sm:w-4 sm:h-4 accent-sage-700 shrink-0" />' +
            '<span class="text-sm">All Studios</span></label>';
          studios.forEach(function (s) {
            html +=
              '<label class="flex items-center gap-3 cursor-pointer py-1.5 sm:py-1 min-h-[40px] sm:min-h-0">' +
              '<input type="checkbox" value="' +
              escapeHtml(s.uuid) +
              '" ' +
              (current === s.uuid ? "checked" : "") +
              ' class="w-5 h-5 sm:w-4 sm:h-4 accent-sage-700 shrink-0" />' +
              '<span class="text-sm">' +
              escapeHtml(s.name) +
              "</span></label>";
          });
          studioFilters.innerHTML = html;
          if (!studios.length) {
            studioFilters.innerHTML =
              '<p class="text-sm text-stone-warm">No studios scheduled for this date.</p>';
          }
        }

        /* ---------- fetch ---------- */

        function timeLabel(start) {
          var h = parseInt(String(start).split(":")[0], 10);
          if (h < 12) return "Morning";
          if (h < 17) return "Afternoon";
          return "Evening";
        }

        function levelLabel(level) {
          if (!level) return "";
          return level.charAt(0).toUpperCase() + level.slice(1);
        }

        async function fetchJSON(url) {
          var res = await fetch(url, { headers: { Accept: "application/json" } });
          var data = await res.json().catch(function () {
            return [];
          });
          if (!res.ok) throw new Error("Failed to load data");
          return Array.isArray(data) ? data : [];
        }

        async function loadStudios() {
          try {
            var all = await fetchJSON(
              "/api/class-schedules?date=" + fmtISO(state.selected),
            );
            var seen = {};
            var studios = [];
            all.forEach(function (s) {
              var st = s.studio;
              if (st && st.uuid && !seen[st.uuid]) {
                seen[st.uuid] = true;
                studios.push(st);
              }
            });
            renderStudioOptions(studios);
          } catch (e) {
            renderStudioOptions([]);
          }
        }

        async function emptyState() {
          var next = new Date(state.selected);
          var found = null;
          for (var i = 1; i <= 14; i++) {
            next.setDate(next.getDate() + 1);
            try {
              var list = await fetchJSON(
                "/api/class-schedules?date=" + fmtISO(next) + "&per_page=1",
              );
              if (list.length) {
                found = new Date(next);
                break;
              }
            } catch (e) {
              break;
            }
          }
          var msg =
            'No classes found for this date and filter selection.';
          var btn = found
            ? '<button type="button" id="nextAvailable" data-date="' +
              fmtISO(found) +
              '" class="block mx-auto mt-4 px-5 py-2.5 rounded-full bg-sage-700 text-white text-sm font-semibold hover:bg-sage-800 transition">See ' +
              found.toLocaleDateString("en-US", {
                weekday: "long",
                month: "long",
                day: "numeric",
              }) +
              "</button>"
            : "";
          scheduleList.innerHTML =
            '<div class="bg-white rounded-[20px] sm:rounded-[24px] border border-sage-100 p-6 sm:p-10 text-center text-stone-warm">' +
            '<p class="text-stone-warm text-sm sm:text-base">' + msg + "</p>" + btn +
            "</div>";
          var b = document.getElementById("nextAvailable");
          if (b) {
            b.addEventListener("click", function () {
              state.selected = new Date(b.getAttribute("data-date") + "T00:00:00");
              state.weekStart = startOfWeek(state.selected);
              renderDates();
              loadAll();
            });
          }
        }

        function renderSchedules(list) {
          scheduleTitle.textContent = state.selected.toLocaleDateString(
            "en-US",
            { weekday: "long", month: "long", day: "numeric" },
          );
          scheduleCount.textContent =
            list.length + (list.length === 1 ? " class" : " classes") + " available";

          var active = [];
          if (state.level) active.push(levelLabel(state.level));
          if (state.time) active.push(levelLabel(state.time));
          if (state.studio) {
            var st = document.querySelector(
              '[data-filter-group="studio"] input[value="' + state.studio + '"]',
            );
            var label = st ? st.closest("label").querySelector("span").textContent : "";
            active.push(label);
          }
          scheduleFilterNote.textContent = active.length
            ? "Filtered: " + active.join(", ")
            : "Showing all classes";

          if (!list.length) {
            scheduleList.innerHTML =
              '<div class="bg-white rounded-[20px] sm:rounded-[24px] border border-sage-100 p-6 sm:p-10 text-center text-stone-warm text-sm sm:text-base">Checking upcoming days...</div>';
            emptyState();
            return;
          }

          scheduleList.innerHTML = list
            .map(function (s) {
              var startH = parseInt(String(s.start_time).split(":")[0], 10);
              var duration = s.duration ? s.duration + " min" : "";
              var capacity = s.capacity != null ? s.capacity : "—";
              var barWidth =
                typeof s.capacity === "number"
                  ? Math.min(100, Math.max(10, s.capacity * 5))
                  : 0;

              return (
                '<article class="bg-white rounded-[20px] sm:rounded-[24px] border border-sage-100 p-4 sm:p-5 mb-3 sm:mb-4 hover:shadow-lg transition overflow-hidden">' +
                '<div class="flex flex-col gap-4 md:flex-row md:items-center md:gap-5">' +
                // Time: horizontal compact row on mobile, column on desktop
                '<div class="flex items-center gap-2.5 sm:gap-3 md:block md:w-[120px] shrink-0">' +
                '<div class="w-12 h-12 sm:w-auto sm:h-auto shrink-0 grid place-items-center md:block rounded-xl bg-sage-50 md:bg-transparent">' +
                '<div class="text-base sm:text-xl font-bold leading-tight">' +
                escapeHtml(s.start_time) +
                "</div></div>" +
                '<div class="min-w-0">' +
                '<div class="text-[13px] sm:text-sm text-stone-warm truncate">' +
                escapeHtml(s.end_time || "—") +
                (duration ? " · " + escapeHtml(duration) : "") +
                "</div></div></div>" +
                '<div class="flex-1 min-w-0">' +
                '<div class="flex flex-wrap items-center gap-1.5 sm:gap-2 mb-1.5 sm:mb-2">' +
                '<span class="px-2.5 py-1 rounded-full bg-sage-50 text-sage-700 text-[11px] sm:text-xs font-semibold">' +
                escapeHtml(levelLabel(s.class && s.class.level)) +
                "</span>" +
                '<span class="px-2.5 py-1 rounded-full bg-stone-50 text-stone-warm text-[11px] sm:text-xs">' +
                escapeHtml(timeLabel(s.start_time)) +
                "</span></div>" +
                '<h3 class="text-[17px] sm:text-lg font-bold leading-snug">' +
                escapeHtml(s.class && s.class.name) +
                "</h3>" +
                '<p class="text-[13px] sm:text-sm text-stone-warm mt-1 line-clamp-2">' +
                escapeHtml((s.class && s.class.description) || "") +
                "</p>" +
                '<div class="flex flex-wrap gap-x-4 sm:gap-x-5 gap-y-1 mt-2.5 sm:mt-3 text-[13px] sm:text-sm text-stone-warm">' +
                '<span class="inline-flex items-center gap-1.5 min-w-0 max-w-full"><span class="truncate">' +
                escapeHtml((s.instructor && s.instructor.name) || "—") +
                "</span></span>" +
                '<span class="inline-flex items-center gap-1.5 min-w-0 max-w-full"><span class="truncate">' +
                escapeHtml((s.studio && s.studio.name) || "—") +
                "</span></span></div></div>" +
                '<div class="flex sm:items-center gap-3 md:block md:w-[150px] shrink-0 border-t border-sage-50 md:border-0 pt-3.5 md:pt-0">' +
                '<div class="flex-1 md:flex-none min-w-0">' +
                '<div class="text-[13px] sm:text-sm font-semibold truncate">' +
                escapeHtml(capacity) +
                " spots capacity</div>" +
                '<div class="w-full h-1.5 bg-stone-100 rounded-full mt-2">' +
                '<div class="h-1.5 bg-sage-600 rounded-full" style="width: ' +
                barWidth +
                '%"></div></div></div>' +
                '<a href="#" onclick="openBooking();return false;" class="shrink-0 inline-flex items-center justify-center md:w-full md:mt-3 bg-sage-700 text-white rounded-full px-5 min-h-[44px] py-2.5 text-sm font-semibold hover:bg-sage-800 active:bg-sage-900 transition">Book</a>' +
                "</div>" +
                "</div></article>"
              );
            })
            .join("");
        }

        async function loadSchedules() {
          scheduleList.innerHTML =
            '<div class="bg-white rounded-[20px] sm:rounded-[24px] border border-sage-100 p-6 sm:p-10 text-center text-stone-warm text-sm sm:text-base">Loading classes...</div>';
          try {
            var params =
              "?date=" + fmtISO(state.selected) + "&per_page=50";
            if (state.level) params += "&level=" + encodeURIComponent(state.level);
            if (state.time) params += "&time=" + encodeURIComponent(state.time);
            if (state.studio)
              params += "&studio_uuid=" + encodeURIComponent(state.studio);
            var list = await fetchJSON("/api/class-schedules" + params);
            renderSchedules(list);
          } catch (e) {
            scheduleList.innerHTML =
              '<div class="bg-white rounded-[20px] sm:rounded-[24px] border border-sage-100 p-6 sm:p-10 text-center text-terracotta-600 text-sm sm:text-base">Failed to load classes. Please try again.</div>';
          }
        }

        function loadAll() {
          loadStudios();
          loadSchedules();
        }

        /* ---------- mobile filter toggle ---------- */

        (function initMobileFilter() {
          var toggle = document.getElementById("filterToggle");
          var aside = document.getElementById("filterAside");
          var chevron = document.getElementById("filterChevron");
          if (!toggle || !aside) return;
          toggle.addEventListener("click", function () {
            var isHidden = aside.classList.contains("hidden");
            aside.classList.toggle("hidden", !isHidden ? true : false);
            toggle.setAttribute("aria-expanded", isHidden ? "true" : "false");
            if (chevron) {
              chevron.style.transform = isHidden ? "rotate(180deg)" : "";
            }
            if (isHidden) {
              aside.scrollIntoView({ behavior: "smooth", block: "nearest" });
            }
          });
          function syncDot() {
            var dot = document.getElementById("filterActiveDot");
            if (!dot) return;
            var active = state.level || state.time || state.studio;
            dot.classList.toggle("hidden", !active);
          }
          var origLoad = loadSchedules;
          loadSchedules = function () {
            syncDot();
            return origLoad();
          };
        })();

        bindGroup("level");
        bindGroup("time");
        bindGroup("studio");

        renderDates();
        loadAll();
      })();
    </script>
  </body>
</html>
