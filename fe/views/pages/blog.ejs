<!DOCTYPE html>
<html lang="id">

<head>
  <%- include('../partials/head') %>
</head>

<body class="antialiased">

  <%- include('../partials/navbar') %>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <h1 class="font-display text-4xl font-bold">
      Artikel & Tips Yoga
    </h1>

    <p class="text-stone-warm mt-2">
      Temukan berbagai tips, panduan, dan informasi seputar yoga untuk mendukung tubuh yang sehat dan pikiran yang lebih tenang.
    </p>

    <!-- Artikel -->
    <div
      id="articleGrid"
      class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-8"
    >

      <% posts.forEach((p, i) => { %>

        <a
          href="/blog/<%= p.slug %>"
          class="article-card bg-white border border-sage-100 rounded-[24px] overflow-hidden hover:shadow-lg transition group <%= i >= 9 ? 'hidden' : '' %>"
        >

          <% if (p.image) { %>
            <img
              src="<%= p.image %>"
              alt="<%= p.title %>"
              class="h-[180px] w-full object-cover group-hover:scale-[1.02] transition"
            >
          <% } %>

          <div class="p-5">

            <div class="flex items-center gap-2 text-xs">

              <% if (p.category) { %>
                <span class="bg-sage-700 text-white px-2.5 py-1 rounded-full font-semibold">
                  <%= p.category %>
                </span>
              <% } %>

              <span class="text-stone-warm">
                <%= p.date %> • <%= p.read %>
              </span>

            </div>

            <h3 class="font-semibold mt-3 leading-tight">
              <%= p.title %>
            </h3>

            <p class="text-sm text-stone-warm mt-1 line-clamp-2">
              <%= p.excerpt %>
            </p>

            <span class="text-xs font-semibold text-sage-700 mt-3 inline-block">
              Baca selengkapnya →
            </span>

          </div>

        </a>

      <% }) %>

    </div>


    <!-- Load More -->
    <% if (posts.length > 9) { %>

      <div class="flex justify-center mt-10">

        <button
          id="loadMoreBtn"
          type="button"
          class="bg-sage-700 text-white px-6 py-3 rounded-full text-sm font-semibold hover:opacity-90 transition"
        >
          Muat Artikel Lainnya
        </button>

      </div>

    <% } %>

  </section>

  <%- include('../partials/footer') %>

  <script src="/js/main.js"></script>

  <script>
    const loadMoreBtn = document.getElementById("loadMoreBtn");
    const articles = document.querySelectorAll(".article-card");

    let visibleCount = 9;
    const loadAmount = 9;

    if (loadMoreBtn) {

      loadMoreBtn.addEventListener("click", () => {

        const nextCount = visibleCount + loadAmount;

        for (
          let i = visibleCount;
          i < nextCount && i < articles.length;
          i++
        ) {
          articles[i].classList.remove("hidden");
        }

        visibleCount = nextCount;

        // Kalau semua artikel sudah tampil
        if (visibleCount >= articles.length) {
          loadMoreBtn.remove();
        }

      });

    }
  </script>

</body>
</html>