<!DOCTYPE html>
<html lang="id">

<head>
  <%- include('../partials/head') %>
</head>

<body class="antialiased">

  <%- include('../partials/navbar') %>

  <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <article>

      <h1 class="font-display text-4xl font-bold text-sage-900">
        <%= page.title %>
      </h1>

      <% if (page.excerpt) { %>
        <p class="mt-3 text-stone-warm text-lg">
          <%= page.excerpt %>
        </p>
      <% } %>

      <div class="page-content mt-8">
        <%- page.content %>
      </div>

    </article>

  </main>

  <%- include('../partials/footer') %>

  <script src="/js/main.js"></script>

</body>
</html>