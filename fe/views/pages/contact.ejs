<!DOCTYPE html>
<html lang="id">
  <head>
    <%- include('../partials/head') %>
  </head>

  <body class="antialiased">
    <%- include('../partials/navbar') %>

    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 pb-20">
      <div class="grid lg:grid-cols-2 gap-10">
        <!-- LEFT -->
        <div>
          <h1 class="font-display text-4xl font-bold">Connect With Us</h1>

          <p class="text-stone-warm mt-2">
            Have a question? We’re here to listen, guide, and help you find what
            feels right for your journey.
          </p>

          <!-- CONTACT INFO -->
          <div class="mt-6 space-y-4">
            <div
              class="flex gap-3 bg-cream border border-sage-100 rounded-2xl p-4"
            >
              <span
                class="w-10 h-10 rounded-xl bg-white border border-sage-100 grid place-items-center"
              >
                📍
              </span>

              <div>
                <div class="font-semibold text-sm">Studio Address</div>

                <div class="text-sm text-stone-warm">
                  <%= contact.address || site.address %>
                </div>
              </div>
            </div>

            <div
              class="flex gap-3 bg-cream border border-sage-100 rounded-2xl p-4"
            >
              <span
                class="w-10 h-10 rounded-xl bg-white border border-sage-100 grid place-items-center"
              >
                📞
              </span>

              <div>
                <div class="font-semibold text-sm">WhatsApp Us</div>

                <div class="text-sm text-stone-warm"><%= site.phone %></div>
              </div>
            </div>
          </div>

          <!-- CONTACT FORM -->
          <form
            action=""
            id="contactForm"
            class="mt-6 bg-white border border-sage-100 rounded-[24px] p-6 space-y-3"
          >
            <h3 class="font-semibold">Send Us a Message</h3>

            <!-- NAMA -->
            <input
              name="nama"
              placeholder="Full Name"
              required
              class="w-full px-4 py-3 rounded-xl border border-sage-200 outline-none focus:border-sage-400"
            />

            <!-- EMAIL -->
            <input
              name="email"
              type="email"
              placeholder="Email Address"
              required
              class="w-full px-4 py-3 rounded-xl border border-sage-200 outline-none focus:border-sage-400"
            />

            <!-- TELEPON -->
            <input
              name="no_telp"
              type="tel"
              inputmode="numeric"
              pattern="[0-9]+"
              placeholder="Active WhatsApp Number"
              required
              class="w-full px-4 py-3 rounded-xl border border-sage-200 outline-none focus:border-sage-400"
            />

            <!-- PESAN -->
            <textarea
              name="isi"
              rows="4"
              placeholder="Tell us how we can help..."
              required
              class="w-full px-4 py-3 rounded-xl border border-sage-200 outline-none focus:border-sage-400"
            ></textarea>

            <!-- CAPTCHA -->
            <div>
              <label class="block text-sm font-medium mb-2">
                <%= captcha?.question || "Verification unavailable" %>
              </label>

              <input
                name="captcha_answer"
                id="captchaAnswer"
                type="number"
                placeholder="Enter your answer"
                required
                class="w-full px-4 py-3 rounded-xl border border-sage-200 outline-none focus:border-sage-400"
              />

              <!-- CAPTCHA ID -->
              <input
                type="hidden"
                name="captcha_id"
                value="<%= captcha?.captcha_id || '' %>"
              />
            </div>

            <!-- BUTTON -->
            <button
              type="submit"
              class="w-full py-3 rounded-full bg-sage-700 text-white font-semibold hover:bg-sage-600 disabled:opacity-50 disabled:cursor-not-allowed"
            >
              Send Message →
            </button>

            <!-- MESSAGE -->
            <p id="contactMsg" class="hidden text-sm p-3 rounded-xl"></p>
          </form>
        </div>

        <!-- RIGHT -->
        <div class="space-y-4">
          <!-- MAP -->
          <div
            class="rounded-[24px] overflow-hidden border border-sage-100 h-[360px] bg-sage-50"
          >
            <iframe
              src="<%= contact.mapEmbed %>"
              class="w-full h-full border-0"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>

           <!-- FAQ -->


                   <div class="max-w-3xl mx-auto mt-10 space-y-3">
    <h2 class="font-display text-2xl font-bold text-center">FAQ & Answers</h2>
      
  <% if (faqs && faqs.length) { %>

    <% faqs.forEach(f => { %>

        <div class="bg-white border border-sage-100 rounded-2xl overflow-hidden">
            <button
                type="button"
                data-faq
                class="w-full text-left px-5 py-4 font-semibold text-sm flex justify-between items-center"
            >
                <%= f.question %>
                <span>+</span>
            </button>

            <div class="hidden px-5 pb-4 text-sm text-stone-warm leading-relaxed">
                <%= f.answer %>
            </div>
        </div>

    <% }) %>

<% } else { %>

    <p class="text-center text-sm text-stone-500">
        No FAQs available.
    </p>
    

<% } %>

                   </div>
              
          
        </div>
      </div>
    </section>

    <%- include('../partials/footer') %>

    <script src="/js/main.js"></script>
  </body>
</html>
