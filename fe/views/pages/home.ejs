<!DOCTYPE html>
<html lang="id">
<head><%- include('../partials/head') %></head>
<body class="antialiased">
<%- include('../partials/navbar') %>

<!-- HERO -->
<section class="relative overflow-hidden bg-cream">
  <div class="absolute inset-0 bg-gradient-to-b from-sage-50 to-transparent h-[60%]"></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-16 lg:py-16">
    <div class="grid lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-7 reveal">
        <span class="inline-flex items-center gap-2 bg-white border border-sage-200 rounded-full px-4 py-1.5 text-xs font-semibold tracking-wide text-sage-700"><%= hero.eyebrow %></span>
        <h1 class="font-display text-[40px] sm:text-5xl lg:text-[56px] font-bold leading-[0.95] mt-5"><%= hero.title %></h1>
        <p class="text-stone-warm leading-relaxed mt-4 max-w-xl text-[15px]"><%= hero.subtitle %></p>
        <div class="flex flex-wrap gap-3 mt-7">
          <button onclick="openBooking()" class="bg-sage-700 hover:bg-sage-600 text-white px-7 py-3.5 rounded-full font-semibold text-sm transition">🧘 <%= hero.ctaPrimary %> →</button>
          <a href="/schedule" class="bg-white border border-sage-200 hover:bg-sage-50 px-7 py-3.5 rounded-full font-semibold text-sm"><%= hero.ctaSecondary %></a>
        </div>
        <div class="flex items-center gap-6 mt-8">
        <div class="flex -space-x-3">
  <% testimonials.slice(0, 3).forEach(t => { %>
    <img
      src="<%= t.foto %>"
      alt="<%= t.nama %>"
      class="w-10 h-10 rounded-full border-2 border-white object-cover"
    >
  <% }) %>
</div>
          <div class="text-sm">
            <div class="font-semibold">2.400+ ulasan ★★★★★</div>
            <div class="text-stone-warm text-xs">Di Google & Instagram</div>
          </div>
        </div>
      </div>
      <div class="lg:col-span-5 relative reveal">
        <div class="relative rounded-[32px] overflow-hidden bg-sage-100 p-3 shadow-xl">
          <img src="<%= hero.image %>" alt="Yoga hero" class="w-full h-[420px] object-cover rounded-[24px]">
          <div class="absolute bottom-6 left-6 right-6 bg-white/90 backdrop-blur rounded-2xl p-4 flex items-center justify-between shadow-lg">
            <div>
              <div class="text-xs font-semibold tracking-widest text-stone-warm">KELAS HARI INI</div>
              <div class="font-semibold">Hatha Morning • 07:00</div>
            </div>
            <button onclick="openBooking('Hatha Morning Flow')" class="bg-sage-700 text-white px-4 py-2 rounded-full text-xs font-semibold">Join →</button>
          </div>
        </div>
        <!-- floating cards -->
        <div class="absolute -left-4 top-10 bg-white rounded-2xl shadow-lg px-4 py-3 hidden lg:flex items-center gap-3">
          <span class="w-9 h-9 rounded-xl bg-sage-100 grid place-items-center">💫</span>
          <div><div class="text-sm font-bold">12K+ Member</div><div class="text-xs text-stone-warm">Bahagia & sehat</div></div>
        </div>
        <div class="absolute -right-2 bottom-20 bg-terracotta-600 text-white rounded-2xl shadow-lg px-4 py-3 hidden lg:block">
          <div class="text-xs opacity-80">KELAS / BULAN</div><div class="font-bold">500+ Sesi</div>
        </div>
      </div>
    </div>

    <!-- stats -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mt-10">
      <% stats.forEach(s=>{ %>
        <div class="bg-white border border-sage-100 rounded-2xl p-5 text-center reveal">
          <div class="font-display text-3xl font-bold text-sage-700"><%= s.value %></div>
          <div class="text-xs tracking-widest font-semibold text-stone-warm mt-1"><%= s.label %></div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- Features -->
<section class="py-14 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-4 gap-6">
      <% features.forEach(f=>{ %>
        <div class="bg-cream border border-sage-100 rounded-2xl p-6 reveal">
          <div class="w-10 h-10 rounded-xl bg-white border border-sage-100 grid place-items-center text-lg"><%= f.icon %></div>
          <h3 class="font-semibold mt-3"><%= f.title %></h3>
          <p class="text-sm text-stone-warm leading-relaxed mt-1"><%= f.desc %></p>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- About -->
<section class="py-16 bg-sage-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-10 items-center">
    <div class="reveal">
      <span class="text-xs font-bold tracking-[0.2em] text-sage-700">TENTANG SERENE</span>
      <h2 class="font-display text-4xl font-bold leading-tight mt-2">Ruang di mana tubuh, napas, dan hati bertemu</h2>
      <p class="text-stone-warm leading-relaxed mt-4">Serene lahir dari kerinduan akan jeda. Di tengah bising Jakarta, kami menciptakan sanctuary — bukan sekadar studio, tapi rumah untuk pulang. Kayu reclaimed, cahaya alami, dan aroma sage menyambutmu setiap kali membuka pintu.</p>
      <ul class="mt-6 space-y-3 text-sm">
        <li class="flex gap-3"><span class="text-sage-600">✓</span> Kelas 60–90 menit, 06:00–21:00 setiap hari</li>
        <li class="flex gap-3"><span class="text-sage-600">✓</span> Props lengkap: Manduka, bolster, singing bowl</li>
        <li class="flex gap-3"><span class="text-sage-600">✓</span> Komunitas non-judgmental, semua tubuh diterima</li>
      </ul>
      <a href="/instructors" class="inline-flex mt-6 bg-white border border-sage-200 px-6 py-3 rounded-full text-sm font-semibold hover:bg-sage-50">Kenali Instruktur →</a>
    </div>
    <div class="grid grid-cols-2 gap-4 reveal">
      <img src="https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?w=600&auto=format&fit=crop&q=60" class="rounded-[24px] h-[320px] object-cover">
      <div class="space-y-4">
        <img src="https://images.unsplash.com/photo-1506126613408-eca07ce68773?w=600&auto=format&fit=crop&q=60" class="rounded-[24px] h-[150px] w-full object-cover">
        <div class="bg-sage-700 text-white rounded-[24px] p-6">
          <div class="text-3xl font-display font-bold">8 Tahun</div>
          <div class="text-sm opacity-80">Ruang untuk merawat tubuh, pikiran, dan jiwa menuju kehidupan yang lebih sehat dan seimbang.</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Classes preview -->
<section class="py-16 bg-cream">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-wrap justify-between items-end gap-4">
      <div>
        <span class="text-xs font-bold tracking-[0.2em] text-terracotta-600">KELAS PILIHAN</span>
        <h2 class="font-display text-4xl font-bold mt-1">Temukan aliranmu</h2>
      </div>
      <a href="/classes" class="bg-sage-700 text-white px-6 py-3 rounded-full text-sm font-semibold">Lihat Semua Kelas →</a>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
      <% classes.forEach(c=>{ %>
        <a href="/classes/<%= c.slug %>" class="bg-white rounded-[24px] overflow-hidden border border-sage-100 hover:shadow-xl transition group reveal">
          <div class="relative">
            <img src="<%= c.image %>" class="h-[190px] w-full object-cover group-hover:scale-[1.02] transition">
            <span class="absolute top-3 left-3 bg-white/90 backdrop-blur px-3 py-1 rounded-full text-xs font-semibold"><%= c.category.toUpperCase() %></span>
            <span class="absolute top-3 right-3 bg-sage-700 text-white px-3 py-1 rounded-full text-xs font-semibold"><%= c.level %></span>
          </div>
          <div class="p-5">
            <h3 class="font-semibold text-[15px]"><%= c.name %></h3>
            <p class="text-sm text-stone-warm line-clamp-2 mt-1"><%= c.desc %></p>
            <div class="flex items-center justify-between mt-4 text-xs text-stone-warm">
              <span>⏱ <%= c.duration %></span><span>👤 <%= c.instructor %></span><span class="font-semibold text-sage-700"><%= c.price %></span>
            </div>
          </div>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- Artikel preview -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-wrap justify-between items-end gap-4">
      <div>
        <span class="text-xs font-bold tracking-[0.2em] text-terracotta-600">ARTIKEL TERBARU</span>
        <h2 class="font-display text-4xl font-bold mt-1">Inspirasi untuk Hidup Seimbang</h2>
      </div>
      <a href="/blog" class="bg-sage-700 text-white px-6 py-3 rounded-full text-sm font-semibold">Lihat Semua Artikel →</a>
    </div>

 <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">

    <% posts.forEach(p => { %>

      <a
        href="/blog/<%= p.slug %>"
        class="bg-white border border-sage-100 rounded-[24px] overflow-hidden hover:shadow-lg transition group"
      >

        <img
          src="<%= p.image %>"
          alt="<%= p.title %>"
          class="h-[200px] w-full object-cover group-hover:scale-[1.02] transition"
        >

        <div class="p-5">

          <div class="flex items-center gap-2 text-xs">

            <span class="bg-sage-700 text-white px-2.5 py-1 rounded-full font-semibold">
              <%= p.category %>
            </span>

            <span class="text-stone-warm">
              <%= p.date %>
            </span>

          </div>

          <h3 class="font-semibold mt-3 leading-tight">
            <%= p.title %>
          </h3>

          <p class="text-sm text-stone-warm mt-2 line-clamp-2">
            <%= p.excerpt %>
          </p>

          <span class="text-xs font-semibold text-sage-700 mt-4 inline-block">
            Baca selengkapnya →
          </span>

        </div>

      </a>

    <% }) %>

  </div>
    
  </div>
</section>

<!-- Testimonials -->
<section class="py-16 bg-sage-900 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <h2 class="font-display text-3xl font-bold text-center">
      Apa kata mereka yang telah bergabung
    </h2>

    <div class="grid md:grid-cols-3 gap-6 mt-8">

      <% testimonials.forEach(t => { %>

        <div class="bg-white/5 border border-white/10 rounded-[24px] p-6 reveal">

          <!-- Rating -->
          <div class="text-terracotta-400">
            ★★★★★
          </div>

          <!-- Testimoni -->
          <p class="text-sm leading-relaxed mt-2 text-sage-100">
            “<%= t.isi_testimoni %>”
          </p>

          <!-- User -->
          <div class="flex items-center gap-3 mt-4">

            <% if (t.foto) { %>
              <img
                src="<%= t.foto %>"
                alt="<%= t.nama %>"
                class="w-10 h-10 rounded-full object-cover"
              >
            <% } else { %>
              <div
                class="w-10 h-10 rounded-full bg-sage-700 flex items-center justify-center"
              >
                <span class="text-sm">
                  <%= t.nama.charAt(0).toUpperCase() %>
                </span>
              </div>
            <% } %>

            <div>
              <div class="text-sm font-semibold">
                <%= t.nama %>
              </div>

              <div class="text-xs text-sage-300">
                <%= t.jabatan || '' %>
              </div>
            </div>

          </div>

        </div>

      <% }) %>

    </div>
  </div>
</section>

<!-- Pricing teaser -->
<section class="py-16 bg-cream">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="font-display text-3xl font-bold text-center">Investasi untuk dirimu</h2>
    <div class="grid md:grid-cols-3 gap-6 mt-8 max-w-5xl mx-auto">
      <% pricing.forEach(p=>{ %>
        <div class="rounded-[24px] p-6 border <%= p.popular ? 'bg-sage-700 text-white border-sage-700 shadow-xl scale-[1.02]' : 'bg-white border-sage-100' %> reveal">
          <% if(p.popular){ %><span class="bg-terracotta-500 text-white text-[10px] font-bold tracking-widest px-3 py-1 rounded-full">PALING POPULER</span><% } %>
          <h3 class="font-display text-xl font-bold mt-3"><%= p.name %></h3>
          <p class="text-sm <%= p.popular ? 'text-sage-200' : 'text-stone-warm' %>"><%= p.desc %></p>
          <div class="mt-4"><span class="text-3xl font-bold">Rp <%= p.price %></span><span class="text-sm <%= p.popular?'text-sage-200':'text-stone-warm' %>"><%= p.period %></span></div>
          <ul class="mt-4 space-y-2 text-sm <%= p.popular?'text-sage-100':'text-stone-warm' %>"><% p.features.slice(0,3).forEach(f=>{ %><li>✓ <%= f %></li><% }) %></ul>
          <button onclick="openBooking()" class="w-full mt-6 py-3 rounded-full font-semibold text-sm <%= p.popular?'bg-white text-sage-700':'bg-sage-700 text-white' %>"><%= p.cta %></button>
        </div>
      <% }) %>
    </div>
    <div class="text-center mt-6"><a href="/pricing" class="text-sm font-semibold text-sage-700">Bandingkan semua paket →</a></div>
  </div>
</section>

<!-- Final CTA -->
<section class="py-16 bg-white">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-sage-700 rounded-[32px] p-8 lg:p-12 text-white relative overflow-hidden text-center reveal">
      <div class="absolute -top-10 -right-10 w-40 h-40 bg-white/10 rounded-full blur-2xl"></div>
      <h2 class="font-display text-3xl lg:text-4xl font-bold">Matrasmu sudah menunggu</h2>
      <p class="text-sage-200 mt-3 max-w-2xl mx-auto">Coba kelas gratis pertamamu. Tidak ada komitmen, hanya napas, gerakan, dan kehadiran.</p>
      <div class="flex flex-wrap justify-center gap-3 mt-6">
        <button onclick="openBooking()" class="bg-white text-sage-700 px-7 py-3.5 rounded-full font-semibold">Klaim Kelas Gratis →</button>
        <a href="/contact" class="border border-white/30 px-7 py-3.5 rounded-full font-semibold hover:bg-white/10">Tanya via WhatsApp</a>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
<script src="/js/main.js"></script>
</body>
</html>
