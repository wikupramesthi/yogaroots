<!DOCTYPE html>
<html lang="id">
<head><%- include('../partials/head') %></head>
<body class="antialiased">
<%- include('../partials/navbar') %>

<!-- HERO -->
<section class="relative overflow-hidden bg-cream">
  <div class="absolute inset-0 bg-gradient-to-b from-sage-50 to-transparent h-[60%]"></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-16 lg:py-16">
    <div class="grid lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-7 reveal">
        <span class="inline-flex items-center gap-2 bg-white border border-sage-200 rounded-full px-4 py-1.5 text-xs font-semibold tracking-wide text-sage-700"><%= hero.eyebrow %></span>
        <h1 class="font-display text-[40px] sm:text-5xl lg:text-[56px] font-bold leading-[0.95] mt-5"><%= hero.title %></h1>
        <p class="text-stone-warm leading-relaxed mt-4 max-w-xl text-[15px]"><%= hero.subtitle %></p>
        <div class="flex flex-wrap gap-3 mt-7">
          <button onclick="openBooking()" class="bg-sage-700 hover:bg-sage-600 text-white px-7 py-3.5 rounded-full font-semibold text-sm transition">🧘 <%= hero.ctaPrimary %> →</button>
          <a href="/classes" class="bg-white border border-sage-200 hover:bg-sage-50 px-7 py-3.5 rounded-full font-semibold text-sm"><%= hero.ctaSecondary %></a>
        </div>
        <div class="flex items-center gap-6 mt-8">
        <div class="flex -space-x-3">
  <% testimonials.slice(0, 3).forEach(t => { %>
    <img
      src="<%= t.foto %>"
      alt="<%= t.nama %>"
      class="w-10 h-10 rounded-full border-2 border-white object-cover"
    >
  <% }) %>
</div>
          <div class="text-sm">
            <div class="font-semibold">2,400+ Reviews ★★★★★</div>
            <div class="text-stone-warm text-xs">Trusted by our community on Google & Instagram</div>
          </div>
        </div>
      </div>
      <div class="lg:col-span-5 relative reveal">
        <div class="relative rounded-[32px] overflow-hidden bg-sage-100 p-3 shadow-xl">
          <img src="<%= hero.image %>" alt="Yoga hero" class="w-full h-[420px] object-cover rounded-[24px]">
          <div class="absolute bottom-6 left-6 right-6 bg-white/90 backdrop-blur rounded-2xl p-4 flex items-center justify-between shadow-lg">
            <div>
<div class="text-xs font-semibold tracking-widest text-stone-warm">
    TODAY'S CLASSES
</div>              <div class="font-semibold">Hatha Morning • 07:00</div>
            </div>
            <button onclick="openBooking('Hatha Morning Flow')" class="bg-sage-700 text-white px-4 py-2 rounded-full text-xs font-semibold">Join →</button>
          </div>
        </div>
        <!-- floating cards -->
        <div class="absolute -left-4 top-10 bg-white rounded-2xl shadow-lg px-4 py-3 hidden lg:flex items-center gap-3">
          <span class="w-9 h-9 rounded-xl bg-sage-100 grid place-items-center">💫</span>
          <div><div class="text-sm font-bold">12K+ Member</div><div class="text-xs text-stone-warm">Bahagia & sehat</div></div>
        </div>
        <div class="absolute -right-2 bottom-20 bg-terracotta-600 text-white rounded-2xl shadow-lg px-4 py-3 hidden lg:block">
<div class="text-xs opacity-80">PRACTICE</div>
<div class="font-bold">All Levels</div>        
</div>
      </div>
    </div>

    <!-- stats -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mt-10">
      <% stats.forEach(s=>{ %>
        <div class="bg-white border border-sage-100 rounded-2xl p-5 text-center reveal">
          <div class="font-display text-3xl font-bold text-sage-700"><%= s.value %></div>
          <div class="text-xs tracking-widest font-semibold text-stone-warm mt-1"><%= s.label %></div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- Features -->
<section class="py-14 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-4 gap-6">
      <% features.forEach(f=>{ %>
        <div class="bg-cream border border-sage-100 rounded-2xl p-6 reveal">
          <div class="w-10 h-10 rounded-xl bg-white border border-sage-100 grid place-items-center text-lg"><%= f.icon %></div>
          <h3 class="font-semibold mt-3"><%= f.title %></h3>
          <p class="text-sm text-stone-warm leading-relaxed mt-1"><%= f.desc %></p>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- About -->
<section class="py-16 bg-sage-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-10 items-center">
<div class="reveal">
  <span class="text-xs font-bold tracking-[0.2em] text-sage-700">ABOUT US</span>
  <h2 class="font-display text-4xl font-bold leading-tight mt-2">A Practice That Grows With You </h2>
  <p class="text-stone-warm leading-relaxed mt-4">Our structured classes and highly trained teachers lead sequences that guide students through their difficulty levels and focus areas. We know your starting point and guide you to your goal. Everything in between is taught with a clear intention.</p>
  <ul class="mt-6 space-y-3 text-sm">
    <li class="flex gap-3"><span class="text-sage-600">✓</span> Thoughtfully curated classes for every level</li>
    <li class="flex gap-3"><span class="text-sage-600">✓</span> Experienced instructors with a mindful approach</li>
    <li class="flex gap-3"><span class="text-sage-600">✓</span> A welcoming space to practice, breathe, and connect</li>
  </ul>
  <a href="/instructors" class="inline-flex mt-6 bg-white border border-sage-200 px-6 py-3 rounded-full text-sm font-semibold hover:bg-sage-50">Meet Our Instructors →</a>
</div>
    <div class="grid grid-cols-2 gap-4 reveal">
      <img src="img/yogaroots_about1.jpg" class="rounded-[24px] h-[320px] object-cover">
      <div class="space-y-4">
        <img src="img/yogaroots_about2.jpg" class="rounded-[24px] h-[150px] w-full object-cover">
        <div class="bg-sage-700 text-white rounded-[24px] p-6">
          <div class="text-3xl font-display font-bold">
            <%= new Date().getFullYear() - 2023 %> Years
        </div>
          <div class="text-sm opacity-80">A space where movement meets mindfulness, helping you care for your body, find inner balance, and live with greater intention.</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Classes preview -->
<section class="py-16 bg-cream">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-wrap justify-between items-end gap-4">
      <div>
        <span class="text-xs font-bold tracking-[0.2em] text-terracotta-600">FEATURED YOGA</span>
        <h2 class="font-display text-4xl font-bold mt-1">Calm Your Mind</h2>
      </div>
      <a href="/classes" class="bg-sage-700 text-white px-6 py-3 rounded-full text-sm font-semibold">View All Classes →</a>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">

    <% classes.slice(0, 3).forEach(c => { %>

        <a
            href="/classes/<%= c.slug %>"
            class="bg-white rounded-[24px] overflow-hidden border border-sage-100 hover:shadow-xl transition group reveal"
        >

            <!-- Image -->
            <div class="relative overflow-hidden">

                <% if (c.image) { %>

                    <img
                        src="<%= c.image %>"
                        alt="<%= c.name %>"
                        class="h-[220px] w-full object-cover group-hover:scale-[1.04] transition duration-500"
                    >

                <% } else { %>

                    <div class="h-[220px] w-full bg-sage-50 flex items-center justify-center">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            class="w-10 h-10 text-sage-600"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M12 20.25c4.97 0 9-3.36 9-7.5 0-3.31-2.69-6-6-6-1.19 0-2.3.35-3.23.95A5.98 5.98 0 0 0 9 6.75a3.75 3.75 0 1 0-7.5 0c0 4.14 4.03 7.5 9 7.5"
                            />
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M12 20.25v-6"
                            />
                        </svg>
                    </div>

                <% } %>

                <!-- Level -->
                <% if (c.level) { %>

                    <span class="absolute top-4 right-4 bg-sage-700 text-white px-3 py-1.5 rounded-full text-[11px] font-semibold uppercase tracking-wide">
                        <%= c.level === 'advance' ? 'ADVANCED' : c.level.toUpperCase() %>
                    </span>

                <% } %>

            </div>


            <!-- Content -->
            <div class="p-6">
                <h3 class="font-display text-2xl font-semibold text-sage-900">
                    <%= c.name %>
                </h3>


                <p class="text-sm text-stone-warm leading-relaxed line-clamp-3 mt-3">
                    <%= c.description || 'Discover a mindful yoga practice designed to support your journey.' %>
                </p>

                <!-- Footer -->
                <div class="flex items-center justify-between mt-7 pt-6 border-t border-stone-100">

                    <!-- Instructor -->
                    <div class="flex items-center gap-3">

                        <% if (c.instructor?.avatar) { %>

                            <img
                                src="<%= c.instructor.avatar %>"
                                alt="<%= c.instructor.name || 'Instructor' %>"
                                class="w-9 h-9 rounded-full object-cover"
                            >

                        <% } else { %>

                            <div class="w-9 h-9 rounded-full bg-sage-50 flex items-center justify-center">

                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    class="w-5 h-5 text-sage-700"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"
                                    />
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M4.5 20.25a7.5 7.5 0 0 1 15 0"
                                    />
                                </svg>

                            </div>

                        <% } %>


                        <div>
                            <span class="block text-[11px] text-stone-400">
                                Instructor
                            </span>

                            <span class="block text-sm font-semibold text-sage-800">
                                <%= c.instructor?.name || 'Yoga Instructor' %>
                            </span>
                        </div>

                    </div>


                    <!-- Arrow -->
                    <div class="w-10 h-10 rounded-full bg-sage-700 text-white flex items-center justify-center group-hover:bg-terracotta-600 group-hover:translate-x-1 transition">

                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            class="w-4 h-4"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M5 12h14"
                            />
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="m13 6 6 6-6 6"
                            />
                        </svg>

                    </div>

                </div>

            </div>

        </a>

    <% }) %>

</div>
  </div>
</section>

<!-- Artikel preview -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-wrap justify-between items-end gap-4">
      <div>
        <span class="text-xs font-bold tracking-[0.2em] text-terracotta-600">LATEST ARTICLES</span>
        <h2 class="font-display text-4xl font-bold mt-1">Inspiration for a Balanced Life</h2>
      </div>
      <a href="/blog" class="bg-sage-700 text-white px-6 py-3 rounded-full text-sm font-semibold">View All Articles →</a>
    </div>

 <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">

    <% posts.forEach(p => { %>

      <a
        href="/blog/<%= p.slug %>"
        class="bg-white border border-sage-100 rounded-[24px] overflow-hidden hover:shadow-lg transition group"
      >

        <img
          src="<%= p.image %>"
          alt="<%= p.title %>"
          class="h-[200px] w-full object-cover group-hover:scale-[1.02] transition"
        >

        <div class="p-5">

          <div class="flex items-center gap-2 text-xs">

            <span class="bg-sage-700 text-white px-2.5 py-1 rounded-full font-semibold">
              <%= p.category %>
            </span>

            <span class="text-stone-warm">
              <%= p.date %>
            </span>

          </div>

          <h3 class="font-semibold mt-3 leading-tight">
            <%= p.title %>
          </h3>

          <p class="text-sm text-stone-warm mt-2 line-clamp-2">
            <%= p.excerpt %>
          </p>

          <span class="text-xs font-semibold text-sage-700 mt-4 inline-block">
            Baca selengkapnya →
          </span>

        </div>

      </a>

    <% }) %>

  </div>
    
  </div>
</section>

<!-- Testimonials -->
<section class="py-16 bg-sage-900 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <h2 class="font-display text-3xl font-bold text-center">
      What Those Who Joined Say
    </h2>

    <div class="grid md:grid-cols-3 gap-6 mt-8">

      <% testimonials.forEach(t => { %>

        <div class="bg-white/5 border border-white/10 rounded-[24px] p-6 reveal">

          <!-- Rating -->
          <div class="text-terracotta-400">
            ★★★★★
          </div>

          <!-- Testimoni -->
          <p class="text-sm leading-relaxed mt-2 text-sage-100">
            “<%= t.isi_testimoni %>”
          </p>

          <!-- User -->
          <div class="flex items-center gap-3 mt-4">

            <% if (t.foto) { %>
              <img
                src="<%= t.foto %>"
                alt="<%= t.nama %>"
                class="w-10 h-10 rounded-full object-cover"
              >
            <% } else { %>
              <div
                class="w-10 h-10 rounded-full bg-sage-700 flex items-center justify-center"
              >
                <span class="text-sm">
                  <%= t.nama.charAt(0).toUpperCase() %>
                </span>
              </div>
            <% } %>

            <div>
              <div class="text-sm font-semibold">
                <%= t.nama %>
              </div>

              <div class="text-xs text-sage-300">
                <%= t.jabatan || '' %>
              </div>
            </div>

          </div>

        </div>

      <% }) %>

    </div>
  </div>
</section>

<!-- Pricing teaser -->
<section class="py-16 bg-cream">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="font-display text-3xl font-bold text-center">A Better You Starts Here</h2>
    <div class="grid md:grid-cols-3 gap-6 mt-8 max-w-5xl mx-auto">
      <% pricing.forEach(p=>{ %>
        <div class="rounded-[24px] p-6 border <%= p.popular ? 'bg-sage-700 text-white border-sage-700 shadow-xl scale-[1.02]' : 'bg-white border-sage-100' %> reveal">
          <% if(p.popular){ %><span class="bg-terracotta-500 text-white text-[10px] font-bold tracking-widest px-3 py-1 rounded-full">PALING POPULER</span><% } %>
          <h3 class="font-display text-xl font-bold mt-3"><%= p.name %></h3>
          <p class="text-sm <%= p.popular ? 'text-sage-200' : 'text-stone-warm' %>"><%= p.desc %></p>
          <div class="mt-4"><span class="text-3xl font-bold">Rp <%= p.price %></span><span class="text-sm <%= p.popular?'text-sage-200':'text-stone-warm' %>"><%= p.period %></span></div>
          <ul class="mt-4 space-y-2 text-sm <%= p.popular?'text-sage-100':'text-stone-warm' %>"><% p.features.slice(0,3).forEach(f=>{ %><li>✓ <%= f %></li><% }) %></ul>
          <button onclick="openBooking()" class="w-full mt-6 py-3 rounded-full font-semibold text-sm <%= p.popular?'bg-white text-sage-700':'bg-sage-700 text-white' %>"><%= p.cta %></button>
        </div>
      <% }) %>
    </div>
    <div class="text-center mt-6"><a href="/pricing" class="text-sm font-semibold text-sage-700">View All Packages →</a></div>
  </div>
</section>

<!-- Final CTA -->
<section class="py-16 bg-white">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-sage-700 rounded-[32px] p-8 lg:p-12 text-white relative overflow-hidden text-center reveal">
      <div class="absolute -top-10 -right-10 w-40 h-40 bg-white/10 rounded-full blur-2xl"></div>
      <h2 class="font-display text-3xl lg:text-4xl font-bold">CLOSE YOUR EYES. FIND CLARITY</h2>
      <p class="text-sage-200 mt-3 max-w-2xl mx-auto">Moments of tranquillity and peace are so rare. You may be experiencing physical and emotional discomfort. Submerged in work, partner and family demands, it can be tough to get a handle on your life, let alone enjoy it.</p>
      <div class="flex flex-wrap justify-center gap-3 mt-6">
        <button onclick="openBooking()" class="bg-white text-sage-700 px-7 py-3.5 rounded-full font-semibold">Start Your Class →</button>
        <a href="https://api.whatsapp.com/send/?phone=6281321221270&text=Hi%2C%20I%20found%20you%20through%20your%20website%20and%20would%20like%20more%20information%20about%20your%20classes.%20Thank%20you%21&app_absent=0" class="border border-white/30 px-7 py-3.5 rounded-full font-semibold hover:bg-white/10">Chat on WhatsApp</a>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
<script src="/js/main.js"></script>
</body>
</html>
