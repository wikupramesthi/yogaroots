<!DOCTYPE html><html lang="id"><head><%- include('../partials/head') %></head><body class="antialiased"><%- include('../partials/navbar') %>
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <h1 class="font-display text-4xl font-bold">Instruktur Kami</h1>
  <p class="text-stone-warm mt-2 max-w-2xl">Mereka bukan sekadar pengajar — mereka pembimbing perjalanan. Bersertifikat internasional, berhati hangat.</p>
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
    <% instructors.forEach(ins=>{ %>
      <div class="bg-white border border-sage-100 rounded-[24px] overflow-hidden hover:shadow-lg transition">
        <img src="<%= ins.image %>" class="w-full h-[260px] object-cover">
        <div class="p-6">
          <h3 class="font-display text-xl font-bold"><%= ins.name %></h3>
          <div class="text-xs font-semibold tracking-wide text-terracotta-600"><%= ins.role %> • <%= ins.exp %></div>
          <p class="text-sm text-stone-warm leading-relaxed mt-2"><%= ins.bio %></p>
          <p class="text-sm italic text-sage-700 mt-3 border-l-2 border-sage-200 pl-3">“<%= ins.quote %>”</p>
          <button onclick="openBooking('Private dengan <%= ins.name %>')" class="mt-4 w-full py-2.5 rounded-full border border-sage-200 text-sm font-semibold hover:bg-sage-50">Book Private →</button>
        </div>
      </div>
    <% }) %>
  </div>
</section>
<%- include('../partials/footer') %><script src="/js/main.js"></script></body></html>
