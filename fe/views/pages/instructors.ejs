<!DOCTYPE html>
<html lang="id">

<head>
    <%- include('../partials/head') %>
</head>

<body class="antialiased bg-cream">

    <%- include('../partials/navbar') %>


    <!-- HEADER -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

        <div class="max-w-2xl">

            <h1 class="font-display text-4xl lg:text-5xl font-bold text-sage-900 mt-3 leading-tight">
                Meet Our
                <span class="text-terracotta-600">Instructors</span>
            </h1>

            <p class="text-stone-warm leading-relaxed mt-4 max-w-xl">
                Meet the instructors who bring experience, intention,
                and warmth into every YogaRoots practice.
            </p>

        </div>

    </section>


    <!-- INSTRUCTORS -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">

        <% if (instructors && instructors.length > 0) { %>

            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">

                <% instructors.forEach(ins => { %>

                    <article
                        class="group bg-white rounded-[24px] border border-sage-100 overflow-hidden hover:shadow-xl transition duration-300"
                    >

                        <!-- IMAGE -->
                        <div class="relative overflow-hidden bg-sage-50">

                            <% if (ins.avatar) { %>

                                <img
                                    src="<%= ins.avatar %>"
                                    alt="<%= ins.name %>"
                                    class="w-full h-[250px] object-cover group-hover:scale-[1.03] transition duration-500"
                                >

                            <% } else { %>

                                <div class="w-full h-[250px] flex items-center justify-center">

                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="1.4"
                                        class="w-14 h-14 text-sage-500"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"
                                        />

                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M4.5 20.25a7.5 7.5 0 0 1 15 0"
                                        />
                                    </svg>

                                </div>

                            <% } %>


                            <!-- SPECIALIZATIONS -->
                            <% if (
                                ins.specializations &&
                                ins.specializations.length > 0
                            ) { %>

                                <div class="absolute bottom-4 left-4 right-4 flex flex-wrap gap-2">

                                    <% ins.specializations.slice(0, 2).forEach(spec => { %>

                                        <span
                                            class="bg-white/90 backdrop-blur-sm px-3 py-1.5 rounded-full text-[10px] font-semibold text-sage-800 shadow-sm"
                                        >
                                            <%= spec.name %>
                                        </span>

                                    <% }) %>


                                    <% if (ins.specializations.length > 2) { %>

                                        <span
                                            class="bg-sage-800/90 text-white px-3 py-1.5 rounded-full text-[10px] font-semibold"
                                        >
                                            +<%= ins.specializations.length - 2 %>
                                        </span>

                                    <% } %>

                                </div>

                            <% } %>

                        </div>


                        <!-- CONTENT -->
                        <div class="p-5">

                            <!-- NAME -->
                            <h2 class="font-display text-2xl font-bold text-sage-900">
                                <%= ins.name %>
                            </h2>


                            <!-- EXPERIENCE -->
                            <% if (ins.pengalaman) { %>

                                <p class="text-xs font-semibold text-terracotta-600 mt-1">
                                    <%= ins.pengalaman %>
                                </p>

                            <% } %>


                            <!-- BIO -->
                            <% if (ins.biografi) { %>

                                <p class="text-sm text-stone-warm leading-relaxed mt-3 line-clamp-3">
                                    <%= ins.biografi %>
                                </p>

                            <% } else { %>

                                <p class="text-sm text-stone-400 leading-relaxed mt-3">
                                    Yoga instructor at YogaRoots, guiding every practice with
                                    mindful movement and intention.
                                </p>

                            <% } %>


                            <!-- FOOTER -->
                            <div class="flex items-center justify-between mt-5 pt-4 border-t border-sage-100">

                                <div class="flex items-center gap-2">

                                    <span class="w-1.5 h-1.5 rounded-full bg-sage-500"></span>

                                    <span class="text-xs text-stone-400">
                                        Yoga Instructor
                                    </span>

                                </div>

                               <button
    type="button"
    onclick="openBooking('Private with <%= ins.name %>')"
    class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-sage-700 text-white text-xs font-semibold hover:bg-sage-800 transition"
>
    Book Private
    <span>→</span>
</button>

                            </div>

                        </div>

                    </article>

                <% }) %>

            </div>


        <% } else { %>


            <!-- EMPTY STATE -->
            <div class="bg-white rounded-[24px] border border-sage-100 py-16 px-6 text-center">

                <div
                    class="w-14 h-14 mx-auto rounded-full bg-sage-50 flex items-center justify-center"
                >

                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        class="w-7 h-7 text-sage-600"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"
                        />

                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M4.5 20.25a7.5 7.5 0 0 1 15 0"
                        />
                    </svg>

                </div>


                <h3 class="font-display text-2xl font-semibold text-sage-900 mt-5">
                    No instructors available
                </h3>


                <p class="text-sm text-stone-warm mt-2">
                    Instructor profiles will appear here soon.
                </p>

            </div>


        <% } %>

    </section>


    <%- include('../partials/footer') %>


    <script src="/js/main.js"></script>

</body>

</html>