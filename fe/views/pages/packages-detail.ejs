<%- include('../partials/head', { title: package.name }) %>
<%- include('../partials/navbar') %>

<%
    const options = Array.isArray(package.options)
        ? package.options
        : [];

    const features = Array.isArray(package.features)
        ? package.features
        : [];

    const isPopular = package.is_popular;

    function formatPrice(price) {
        return new Intl.NumberFormat('id-ID').format(
            Number(price || 0)
        );
    }

    function formatDuration(duration, unit) {
        if (!duration) return '';

        const units = {
            day: duration == 1 ? 'day' : 'days',
            week: duration == 1 ? 'week' : 'weeks',
            month: duration == 1 ? 'month' : 'months',
            year: duration == 1 ? 'year' : 'years'
        };

        return `${duration} ${units[unit] || unit || ''}`;
    }
%>

<main class="bg-cream min-h-screen">

    <!-- HERO -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-8">
        <div class="max-w-6xl mx-auto px-6">

            <a
                href="/packages"
                class="inline-flex items-center gap-2
                       text-sm text-stone-warm
                       hover:text-sage-700 transition mb-8"
            >
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="16"
                     height="16"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"></polyline>
                </svg>

                Back to Membership
            </a>

            <div class="max-w-3xl">

                <% if (isPopular) { %>
                    <span
                        class="inline-flex items-center gap-1.5
                               bg-terracotta-500
                               text-white
                               text-[10px]
                               font-bold
                               tracking-widest
                               px-3 py-1.5
                               rounded-full
                               mb-5"
                    >
                        <i class="bi bi-star-fill"></i>
                        MOST POPULAR
                    </span>
                <% } %>

                <h1
                    class="font-display
                           text-4xl md:text-5xl
                           font-bold
                           text-sage-900
                           leading-tight"
                >
                    <%= package.name %>
                </h1>

                <% if (package.description) { %>
                    <p
                        class="mt-4
                               text-base md:text-lg
                               leading-relaxed
                               text-stone-warm
                               max-w-2xl"
                    >
                        <%= package.description %>
                    </p>
                <% } %>

            </div>

        </div>
    </section>


    <!-- CONTENT -->
    <section class="pb-20">
        <div
            class="max-w-6xl
                   mx-auto
                   px-6
                   grid
                   grid-cols-1
                   lg:grid-cols-3
                   gap-8"
        >

            <!-- LEFT -->
            <div class="lg:col-span-2 space-y-6">

                <!-- OPTIONS -->
                <div
                    class="bg-white
                           border border-stone-200
                           rounded-[24px]
                           p-6 md:p-8"
                >
                    <div class="mb-6">
                        <h2
                            class="font-display
                                   text-2xl
                                   font-bold
                                   text-sage-900"
                        >
                            Choose Your Option
                        </h2>

                        <p class="text-sm text-stone-400 mt-1">
                            Select the option that best fits your practice.
                        </p>
                    </div>

                    <div class="space-y-3">

                        <% options.forEach(function(option, index) { %>

                            <div
                                class="relative
                                       rounded-2xl
                                       border border-stone-200
                                       bg-stone-50
                                       p-5
                                       transition
                                       hover:border-sage-300
                                       hover:bg-white"
                            >

                                <div
                                    class="flex
                                           flex-col
                                           sm:flex-row
                                           sm:items-center
                                           sm:justify-between
                                           gap-4"
                                >

                                    <div>

                                        <h3
                                            class="font-semibold
                                                   text-sage-900"
                                        >
                                            <%= option.name %>
                                        </h3>

                                        <div
                                            class="flex
                                                   flex-wrap
                                                   items-center
                                                   gap-3
                                                   mt-2
                                                   text-xs
                                                   text-stone-400"
                                        >

                                            <% if (option.quota) { %>
                                                <span class="inline-flex items-center gap-1">
                                                    <i class="bi bi-check-circle"></i>
                                                    <%= option.quota %> classes
                                                </span>
                                            <% } %>

                                            <% if (option.duration) { %>
                                                <span class="inline-flex items-center gap-1">
                                                    <i class="bi bi-calendar3"></i>
                                                    <%= formatDuration(
                                                        option.duration,
                                                        option.duration_unit
                                                    ) %>
                                                </span>
                                            <% } %>

                                        </div>

                                    </div>


                                    <div class="sm:text-right shrink-0">

                                        <% if (
                                            option.discount_price &&
                                            Number(option.discount_price) < Number(option.price)
                                        ) { %>

                                            <p class="text-xs text-stone-400 line-through">
                                                Rp <%= formatPrice(option.price) %>
                                            </p>

                                        <% } %>

                                        <p
                                            class="text-lg
                                                   font-bold
                                                   text-sage-700"
                                        >
                                            Rp <%= formatPrice(
                                                option.final_price ?? option.price
                                            ) %>
                                        </p>

                                    </div>

                                </div>

                            </div>

                        <% }) %>

                    </div>
                </div>


                <!-- FEATURES -->
                <% if (features.length > 0) { %>

                    <div
                        class="bg-white
                               border border-stone-200
                               rounded-[24px]
                               p-6 md:p-8"
                    >

                        <h2
                            class="font-display
                                   text-2xl
                                   font-bold
                                   text-sage-900"
                        >
                            What's Included
                        </h2>

                        <div
                            class="grid
                                   grid-cols-1
                                   sm:grid-cols-2
                                   gap-x-8
                                   gap-y-4
                                   mt-6"
                        >

                            <% features.forEach(function(feature) { %>

                                <div
                                    class="flex
                                           items-start
                                           gap-3
                                           text-sm
                                           text-stone-warm"
                                >
                                    <span
                                        class="text-sage-700
                                               shrink-0
                                               mt-0.5"
                                    >
                                        <svg xmlns="http://www.w3.org/2000/svg"
                                             width="18"
                                             height="18"
                                             viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="2.5"
                                             stroke-linecap="round"
                                             stroke-linejoin="round">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                    </span>

                                    <span>
                                        <%= feature.feature %>
                                    </span>
                                </div>

                            <% }) %>

                        </div>

                    </div>

                <% } %>

            </div>


            <!-- RIGHT -->
            <aside>

                <div
                    class="bg-sage-700
                           text-white
                           rounded-[24px]
                           p-7
                           lg:sticky
                           lg:top-28"
                >

                    <p
                        class="text-xs
                               uppercase
                               tracking-widest
                               text-sage-200"
                    >
                        Yogaroots Membership
                    </p>

                    <h2
                        class="font-display
                               text-2xl
                               font-bold
                               mt-2"
                    >
                        <%= package.name %>
                    </h2>

                    <div
                        class="border-t
                               border-white/10
                               my-6"
                    ></div>

                    <p class="text-sm text-sage-200 leading-relaxed">
                        Find the option that works best for your practice and
                        make every session at Yogaroots count.
                    </p>

                     <button onclick="openBooking()"
                        class="w-full
                               mt-7
                               py-3.5
                               rounded-full
                               bg-white
                               text-sage-700
                               flex
                               items-center
                               justify-center
                               gap-2
                               font-semibold
                               text-sm
                               hover:bg-sage-50
                               transition"
                    >
                        Choose Your Package

                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="17"
                             height="17"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </button>

                </div>

            </aside>

        </div>
    </section>

</main>


    <script src="/js/main.js"></script>

<%- include('../partials/footer') %>