<!DOCTYPE html><html lang="id"><head><%- include('../partials/head') %></head><body class="antialiased"><%- include('../partials/navbar') %>
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <a href="/classes" class="text-sm text-sage-700 font-medium">← Kembali ke Kelas</a>
  <div class="grid lg:grid-cols-2 gap-10 mt-6">
    <img src="<%= cls.image %>" class="w-full h-[420px] object-cover rounded-[24px]">
    <div>
      <span class="inline-block bg-sage-700 text-white px-3 py-1 rounded-full text-xs font-semibold"><%= cls.category %> • <%= cls.level %></span>
      <h1 class="font-display text-4xl font-bold mt-3"><%= cls.name %></h1>
      <p class="text-stone-warm leading-relaxed mt-3"><%= cls.desc %> Kelas ini dirancang untuk membangun kesadaran tubuh, melatih napas, dan mengundang ketenangan yang bertahan lama setelah savasana.</p>
      <div class="grid grid-cols-3 gap-3 mt-6">
        <div class="bg-cream border border-sage-100 rounded-2xl p-4 text-center"><div class="text-xs text-stone-warm">DURASI</div><div class="font-semibold"><%= cls.duration %></div></div>
        <div class="bg-cream border border-sage-100 rounded-2xl p-4 text-center"><div class="text-xs text-stone-warm">INSTRUKTUR</div><div class="font-semibold"><%= cls.instructor %></div></div>
        <div class="bg-cream border border-sage-100 rounded-2xl p-4 text-center"><div class="text-xs text-stone-warm">HARGA</div><div class="font-bold text-sage-700"><%= cls.price %></div></div>
      </div>
      <div class="bg-sage-50 border border-sage-100 rounded-2xl p-4 mt-6 text-sm"><strong>Jadwal:</strong> <%= cls.time %></div>
      <button onclick="openBooking('<%= cls.name %>')" class="w-full mt-6 py-3.5 rounded-full bg-sage-700 text-white font-semibold hover:bg-sage-600">Book <%= cls.name %> →</button>
      <div class="mt-8">
        <h3 class="font-semibold">Apa yang akan kamu pelajari</h3>
        <ul class="mt-2 space-y-2 text-sm text-stone-warm">
          <li>✓ Teknik pernapasan & mindfulness</li>
          <li>✓ Alignment aman untuk semua tubuh</li>
          <li>✓ Relaksasi mendalam & savasana terpandu</li>
        </ul>
      </div>
    </div>
  </div>
</section>
<%- include('../partials/footer') %><script src="/js/main.js"></script></body></html>
