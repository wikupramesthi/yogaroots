<!DOCTYPE html>
<html lang="id">

<head>
    <%- include('../partials/head') %>
</head>

<body class="antialiased">

    <%- include('../partials/navbar') %>

    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

        <a href="/classes"
            class="inline-flex items-center gap-2 text-sm text-sage-700 font-medium hover:text-sage-900 transition">
            ← Kembali ke Kelas
        </a>

        <div class="grid lg:grid-cols-2 gap-10 mt-6">

            <!-- IMAGE -->
            <div>
                <% if (cls.image) { %>

                    <img
                        src="<%= cls.image %>"
                        alt="<%= cls.name %>"
                        class="w-full h-[420px] object-cover rounded-[24px]"
                    >

                <% } else { %>

                    <div
                        class="w-full h-[420px] rounded-[24px] bg-sage-50 flex items-center justify-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            class="w-16 h-16 text-sage-600"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M12 20.25c4.97 0 9-3.36 9-7.5 0-3.31-2.69-6-6-6-1.19 0-2.3.35-3.23.95A5.98 5.98 0 0 0 9 6.75a3.75 3.75 0 1 0-7.5 0c0 4.14 4.03 7.5 9 7.5"
                            />
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M12 20.25v-6"
                            />
                        </svg>
                    </div>

                <% } %>
            </div>


            <!-- CONTENT -->
            <div>

                <!-- LEVEL -->
                <% if (cls.level) { %>

                    <span
                        class="inline-block bg-sage-700 text-white px-3 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wide"
                    >
                        <%= cls.level === 'advance'
                            ? 'Advanced'
                            : cls.level.charAt(0).toUpperCase() + cls.level.slice(1)
                        %>
                    </span>

                <% } %>


                <!-- TITLE -->
                <h1 class="font-display text-4xl font-bold mt-4 text-sage-900">
                    <%= cls.name %>
                </h1>


                <!-- DESCRIPTION -->
                <p class="text-stone-warm leading-relaxed mt-4">
                    <%= cls.description || 'Discover a mindful yoga practice designed to support your journey.' %>
                </p>


                <!-- INFO -->
                <div class="grid grid-cols-2 gap-3 mt-7">

                    <!-- INSTRUCTOR -->
                    <div class="bg-cream border border-sage-100 rounded-2xl p-4">

                        <div class="text-xs text-stone-warm mb-2">
                            INSTRUCTOR
                        </div>

                        <div class="flex items-center gap-3">

                            <% if (cls.instructor?.avatar) { %>

                                <img
                                    src="<%= cls.instructor.avatar %>"
                                    alt="<%= cls.instructor.name || 'Instructor' %>"
                                    class="w-10 h-10 rounded-full object-cover"
                                >

                            <% } else { %>

                                <div class="w-10 h-10 rounded-full bg-sage-50 flex items-center justify-center">

                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="1.5"
                                        class="w-5 h-5 text-sage-700"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"
                                        />
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M4.5 20.25a7.5 7.5 0 0 1 15 0"
                                        />
                                    </svg>

                                </div>

                            <% } %>

                            <div>
                                <div class="font-semibold text-sage-800">
                                    <%= cls.instructor?.name || 'Yoga Instructor' %>
                                </div>
                            </div>

                        </div>

                    </div>


                    <!-- PRICE -->
                    <div class="bg-cream border border-sage-100 rounded-2xl p-4">

                        <div class="text-xs text-stone-warm mb-2">
                            PRICE
                        </div>

                        <div class="font-bold text-lg text-sage-700">
                            Rp <%= Number(cls.price || 0).toLocaleString('id-ID') %>
                        </div>

                    </div>

                </div>


                <!-- SCHEDULE -->
                <div class="bg-sage-50 border border-sage-100 rounded-2xl p-5 mt-6">

                    <div class="flex items-center justify-between">

                        <div>
                            <div class="text-xs text-stone-warm">
                                CLASS SCHEDULE
                            </div>

                            <div class="font-semibold text-sage-900 mt-1">
                                Choose your preferred schedule
                            </div>
                        </div>

                        <div class="text-sage-700 text-xl">
                            →
                        </div>

                    </div>

                    <p class="text-sm text-stone-warm mt-2">
                        Available schedules will be shown when you book this class.
                    </p>

                </div>


                <!-- BOOK BUTTON -->
                <button
                    onclick="openBooking('<%= cls.name %>')"
                    class="w-full mt-6 py-3.5 rounded-full bg-sage-700 text-white font-semibold hover:bg-sage-600 transition"
                >
                    Book <%= cls.name %> →
                </button>


                <!-- WHAT YOU'LL LEARN -->
                <div class="mt-8">

                    <h3 class="font-semibold text-sage-900">
                        Apa yang akan kamu pelajari
                    </h3>

                    <ul class="mt-3 space-y-2 text-sm text-stone-warm">

                        <li>✓ Teknik pernapasan & mindfulness</li>

                        <li>✓ Alignment aman untuk semua tubuh</li>

                        <li>✓ Relaksasi mendalam & savasana terpandu</li>

                    </ul>

                </div>

            </div>

        </div>

    </section>

    <%- include('../partials/footer') %>

    <script src="/js/main.js"></script>

</body>

</html>