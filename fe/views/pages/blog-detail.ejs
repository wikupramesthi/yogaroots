<!DOCTYPE html>
<html lang="id">
  <head>
    <%- include('../partials/head') %>
  </head>
  <body class="antialiased">
    <%- include('../partials/navbar') %>
    <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <a href="/blog" class="text-sm text-sage-700 font-medium"
        >← Kembali ke Jurnal</a
      >
      <img
        src="<%= post.image %>"
        class="w-full h-[360px] object-cover rounded-[24px] mt-6"
      />
      <div class="flex gap-2 mt-4 text-xs">
        <span
          class="bg-sage-700 text-white px-3 py-1 rounded-full font-semibold"
          ><%= post.category %></span
        ><span class="text-stone-warm"
          ><%= post.date %> • <%= post.read %></span
        >
      </div>
      <h1 class="font-display text-3xl font-bold mt-3 leading-tight">
        <%= post.title %>
      </h1>

      <div class="article-content mt-8 text-stone-warm mt-3 leading-relaxed">
        <%- post.content %>
      </div>

      <div
        class="bg-white border border-sage-100 rounded-[24px] p-6 mt-8 flex flex-col lg:flex-row justify-between gap-4 items-start lg:items-center"
      >
        <div>
          <h3 class="font-semibold text-sage-900">
            Need help finding your flow?
          </h3>

          <p class="text-sm text-stone-500 mt-1">
            Not sure which class is right for you? Chat with our team on
            WhatsApp and we'll help you find the perfect practice.
          </p>
        </div>

        <a
          href="https://api.whatsapp.com/send/?phone=6281321221270&text=Hi%2C%20I%20found%20you%20through%20your%20website%20and%20would%20like%20more%20information%20about%20your%20classes.%20Thank%20you%21&app_absent=0"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-sage-700 text-white px-6 py-3 rounded-full text-sm font-semibold shrink-0 hover:bg-sage-800 transition"
        >
          Chat on WhatsApp →
        </a>
      </div>
    </article>
    <%- include('../partials/footer') %>
    <script src="/js/main.js"></script>
  </body>
</html>
