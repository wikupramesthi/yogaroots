{
  "name": "serene-yoga-theme",
  "version": "1.0.0",
  "description": "Tema Yoga lengkap — Tailwind CSS v4 + EJS + Express. Fitur lengkap siap pakai untuk studio yoga, wellness & meditation.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build:css": "npx @tailwindcss/cli -i ./public/css/input.css -o ./public/css/output.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./public/css/input.css -o ./public/css/output.css --watch",
    "dev:all": "concurrently \"npm run watch:css\" \"node --watch server.js\""
  },
  "keywords": [
    "yoga",
    "tailwind",
    "ejs",
    "express",
    "wellness",
    "theme"
  ],
  "author": "Serene Yoga",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.4.2",
    "ejs": "^3.1.10",
    "ejs-mate": "^4.0.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.1.0"
  }
}
