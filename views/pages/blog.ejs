<!DOCTYPE html><html lang="id"><head><%- include('../partials/head') %></head><body class="antialiased"><%- include('../partials/navbar') %>
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <h1 class="font-display text-4xl font-bold">Jurnal Mindfulness</h1>
  <p class="text-stone-warm mt-2">Tulisan untuk menemani praktikmu — dari napas, anatomi, hingga cerita komunitas.</p>
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
    <% posts.forEach(p=>{ %>
      <a href="/blog/<%= p.slug %>" class="bg-white border border-sage-100 rounded-[24px] overflow-hidden hover:shadow-lg transition group">
        <img src="<%= p.image %>" class="h-[180px] w-full object-cover group-hover:scale-[1.02] transition">
        <div class="p-5">
          <div class="flex items-center gap-2 text-xs"><span class="bg-sage-700 text-white px-2.5 py-1 rounded-full font-semibold"><%= p.category %></span><span class="text-stone-warm"><%= p.date %> • <%= p.read %></span></div>
          <h3 class="font-semibold mt-3 leading-tight"><%= p.title %></h3>
          <p class="text-sm text-stone-warm mt-1 line-clamp-2"><%= p.excerpt %></p>
          <span class="text-xs font-semibold text-sage-700 mt-3 inline-block">Baca selengkapnya →</span>
        </div>
      </a>
    <% }) %>
  </div>
</section>
<%- include('../partials/footer') %><script src="/js/main.js"></script></body></html>
