<!DOCTYPE html><html lang="id"><head><%- include('../partials/head') %></head><body class="antialiased"><%- include('../partials/navbar') %>
<section class="bg-cream py-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <span class="text-xs font-bold tracking-[0.2em] text-terracotta-600">KELAS YOGA</span>
    <h1 class="font-display text-4xl font-bold mt-1">Temukan aliranmu</h1>
    <p class="text-stone-warm mt-2 max-w-2xl">Dari Hatha yang lembut hingga Ashtanga yang menantang — semua ada tempatnya. Filter berdasarkan gaya dan temukan yang memanggilmu hari ini.</p>

    <div class="flex flex-wrap gap-2 mt-6">
      <% categories.forEach(cat=>{ %>
        <a href="/classes?category=<%= cat.slug %>" class="px-5 py-2.5 rounded-full text-sm font-semibold border transition <%= activeCategory===cat.slug ? 'bg-sage-700 text-white border-sage-700' : 'bg-white border-sage-200 hover:bg-sage-50' %>"><%= cat.label %></a>
      <% }) %>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-8">
      <% classes.forEach(c=>{ %>
        <a href="/classes/<%= c.slug %>" class="bg-white rounded-[24px] overflow-hidden border border-sage-100 hover:shadow-xl transition group reveal">
          <div class="relative">
            <img src="<%= c.image %>" class="h-[200px] w-full object-cover group-hover:scale-[1.02] transition">
            <span class="absolute top-3 left-3 bg-white/90 backdrop-blur px-3 py-1 rounded-full text-xs font-semibold"><%= c.category %></span>
            <span class="absolute top-3 right-3 bg-sage-700 text-white px-3 py-1 rounded-full text-xs font-semibold"><%= c.level %></span>
          </div>
          <div class="p-5">
            <h3 class="font-semibold"><%= c.name %></h3>
            <p class="text-sm text-stone-warm line-clamp-2 mt-1"><%= c.desc %></p>
            <div class="flex flex-wrap gap-2 mt-3 text-xs">
              <span class="bg-sage-50 border border-sage-100 px-2.5 py-1 rounded-full">⏱ <%= c.duration %></span>
              <span class="bg-sage-50 border border-sage-100 px-2.5 py-1 rounded-full"><%= c.time %></span>
            </div>
            <div class="flex justify-between items-center mt-4">
              <span class="text-xs text-stone-warm">👤 <%= c.instructor %></span>
              <span class="font-bold text-sage-700 text-sm"><%= c.price %></span>
            </div>
          </div>
        </a>
      <% }) %>
    </div>
    <% if(classes.length===0){ %><p class="text-center text-stone-warm py-10">Tidak ada kelas di kategori ini.</p><% } %>
  </div>
</section>
<%- include('../partials/footer') %><script src="/js/main.js"></script></body></html>
